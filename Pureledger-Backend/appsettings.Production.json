{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "PureLedger.Filters.ValidateXsrfTokenAttribute": "Information",
      "PureLedger.Controllers.Api.AccountApiController": "Information"
    }
  },
  "Security": {
    "CookieSettings": {
      "SecurePolicy": "Always"
    }
  },
  "DataProtection": {
    "KeysDirectory": "/var/www/pureledger/backend-publish/keys"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.tradeledger.cloud",
      "https://tradeledger.cloud"
    ]
  }
}
