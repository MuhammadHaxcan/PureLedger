@model List<PureLedger.Models.JournalVoucher>
@{
    ViewData["Title"] = "Base Vouchers";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-layer-group me-2"></i>Base Vouchers</h2>
        <a href="@Url.Action("Entry", "Home")" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Create New Base Voucher
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Available Base Vouchers</h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i> No base vouchers available for processing.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="baseVouchersTable" width="100%" cellspacing="0">
                        <thead class="table-primary">
                            <tr>
                                <th>Voucher ID</th>
                                <th>Project</th>
                                <th>Entry Date</th>
                                <th>Available Items</th>
                                <th>Total Items</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var voucher in Model)
                            {
                                // Add null-conditional operators to avoid null reference exceptions
                                var unprocessedEntries = voucher.JournalEntries?.Count(e => !e.IsProcessed && e.Quantity > 0) ?? 0;
                                var totalEntries = voucher.JournalEntries?.Count ?? 0;
                                var isProcessable = unprocessedEntries > 0;
                                var statusClass = isProcessable ? "badge bg-success" : "badge bg-secondary";
                                var statusText = isProcessable ? "Ready for Processing" : "Fully Processed";

                                <tr>
                                    <td>JV-@voucher.JournalVoucherId</td>
                                    <td>@(voucher.Project?.ProjectName ?? "Unknown Project")</td>
                                    <td>@voucher.EntryDate.ToString("dd/MM/yyyy")</td>
                                    <td>@unprocessedEntries</td>
                                    <td>@totalEntries</td>
                                    <td><span class="@statusClass">@statusText</span></td>
                                    <td>
                                        @if (isProcessable)
                                        {
                                            <a href="@Url.Action("ProcessBaseVoucher", "Home", new { id = voucher.JournalVoucherId })" 
                                               class="btn btn-sm btn-primary">
                                                <i class="fas fa-cogs me-1"></i> Process
                                            </a>
                                            <button class="btn btn-sm btn-warning ms-1 mark-missed-btn" 
                                                    data-voucher-id="@voucher.JournalVoucherId">
                                                <i class="fas fa-times-circle me-1"></i> Mark Missed
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary" disabled>
                                                <i class="fas fa-check-circle me-1"></i> Completed
                                            </button>
                                        }
                                        
                                        <a href="@Url.Action("VoucherEntry", "Home", new { jvId = voucher.JournalVoucherId })" 
                                           class="btn btn-sm btn-info ms-1">
                                            <i class="fas fa-eye me-1"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Missed Entries Confirmation Modal -->
<div class="modal fade" id="missedEntriesModal" tabindex="-1" aria-labelledby="missedEntriesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="missedEntriesModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Mark Entries as Missed
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Customer:</strong> <span id="customerName"></span>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-bordered table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Rate</th>
                                <th>Discount</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody id="missedEntriesTable">
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-warning mt-3">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    These entries will be marked as missed and cannot be processed later. Are you sure you want to continue?
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-warning" id="confirmMissedBtn">
                    <i class="fas fa-check me-1"></i> Confirm Missed Entries
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/base-vouchers.js" asp-append-version="true"></script>
}