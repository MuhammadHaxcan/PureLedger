@model List<ModifiedEntriesSummaryViewModel>
@{
    ViewData["Title"] = "Modified Entries";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-history me-2"></i>Modified Entries
        </h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="alertArea">
        <!-- Dynamic alerts will be shown here -->
    </div>

    <!-- Modified Entries Display Card -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-list-alt me-2"></i>Modified Voucher Entries
            </h6>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary">@Model.Count entries</span>
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="entriesSearch" placeholder="Search entries...">
                </div>
            </div>
        </div>

        <div class="card-body">
            <div id="entriesContainer">
                <div class="table-responsive">
                    <table id="modifiedEntriesTable" class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Voucher ID</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="entriesTableBody">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="fw-bold">JV-@item.JvId</span></td>
                                        <td>@item.TotalDebit.ToString("N2")</td>
                                        <td>@item.TotalCredit.ToString("N2")</td>
                                        <td class="text-center">
                                            <a asp-action="VoucherModifiedEntries"
                                               asp-route-jvId="@item.JvId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye me-1"></i>View Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (Model == null || !Model.Any())
                {
                    <div id="noEntriesMessage" class="text-center py-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No modified entries found.</p>
                    </div>
                }
                else
                {
                    <div id="noEntriesMessage" class="text-center py-4" style="display: none;">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No entries match your search criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Search functionality
            const entriesSearch = document.getElementById('entriesSearch');
            if (entriesSearch) {
                entriesSearch.addEventListener('input', debounce(filterEntries, 250));
            }

            function filterEntries() {
                const searchTerm = entriesSearch.value.toLowerCase();
                const rows = document.querySelectorAll('#entriesTableBody tr');
                const noEntriesMessage = document.getElementById('noEntriesMessage');
                let visibleCount = 0;
                
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const shouldShow = text.includes(searchTerm);
                    row.style.display = shouldShow ? '' : 'none';
                    if (shouldShow) visibleCount++;
                });
                
                // Show/hide no results message
                if (noEntriesMessage) {
                    if (visibleCount === 0 && rows.length > 0) {
                        noEntriesMessage.style.display = 'block';
                        noEntriesMessage.innerHTML = `
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No entries match your search criteria.</p>
                        `;
                    } else {
                        noEntriesMessage.style.display = 'none';
                    }
                }
            }

            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            // Auto-dismiss alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    if (alert.parentNode) {
                        const bootstrapAlert = bootstrap.Alert.getOrCreateInstance(alert);
                        bootstrapAlert.close();
                    }
                }, 5000);
            });
        });
    </script>
}

<style>
    .table th {
        border-top: none;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        color: #6c757d;
    }

    .fw-bold {
        font-weight: 600 !important;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.5em 0.75em;
    }

    .btn-outline-primary:hover {
        transform: translateY(-1px);
        transition: all 0.2s ease-in-out;
    }

    .alert {
        border-left: 4px solid;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    .alert-danger {
        border-left-color: #dc3545;
    }
</style>