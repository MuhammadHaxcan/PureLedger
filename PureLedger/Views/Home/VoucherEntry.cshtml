@{
    ViewBag.Title = "Voucher Entry & Summary";
}


<div class="container-fluid py-4">
    <h2>Voucher Lookup</h2>
    <div class="mb-3 row">
        <label for="voucherIdInput" class="col-sm-2 col-form-label">Enter Voucher ID:</label>
        <div class="col-sm-4">
            <input type="number" id="voucherIdInput" class="form-control" min="1" />
        </div>
        <div class="col-sm-2">
            <button id="fetchVoucherBtn" class="btn btn-primary">Fetch Voucher Summary</button>
        </div>
    </div>

    <div id="voucherSummaryContainer" style="display:none;">
        <h3>Voucher Summary</h3>
        <div class="table-responsive">
            <table class="table table-striped table-sm" id="voucherSummaryTable">
                <thead>
                    <tr>
                        <th>Account Name</th>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th>Rate</th>
                        <th>Discount</th>
                        <th>Discount %</th>
                        <th>Debit</th>
                        <th>Credit</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Populated by JS -->
                </tbody>
                <tfoot>
                    <tr class="table-info fw-bold">
                        <td colspan="6" class="text-end">Total:</td>
                        <td id="totalDebit">0.00</td>
                        <td id="totalCredit">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div id="noVoucherMsg" class="alert alert-warning" style="display:none;">
        No voucher found for the entered ID.
    </div>
</div>

<!-- Edit Entry Modal -->
<div class="modal fade" id="editEntryModal" tabindex="-1" aria-labelledby="editEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form id="editEntryForm" autocomplete="off">
                <div class="modal-header py-2">
                    <h5 class="modal-title" id="editEntryModalLabel">Edit Journal Entry</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editEntryId" name="EntryId" />
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label class="form-label small mb-1">Category</label>
                            <select id="editCategory" name="CategoryId" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Account</label>
                            <select id="editAccount" name="AccountId" class="form-select form-select-sm"></select>
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Description</label>
                            <input type="text" class="form-control form-control-sm" id="editDescription" name="Description">
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Quantity</label>
                            <input type="number" class="form-control form-control-sm" id="editQuantity" name="Quantity" min="0">
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Rate</label>
                            <input type="number" class="form-control form-control-sm" id="editRate" name="Rate" min="0" step="0.01">
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Discount</label>
                            <input type="number" class="form-control form-control-sm" id="editDiscount" name="Discount" min="0" step="0.01">
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Discount %</label>
                            <input type="number" class="form-control form-control-sm" id="editDiscountPercent" name="DiscountPercent" min="0" max="100" step="0.01">
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Debit</label>
                            <input type="number" class="form-control form-control-sm" id="editDebit" name="Debit" min="0" step="0.01">
                        </div>
                        <div class="col">
                            <label class="form-label small mb-1">Credit</label>
                            <input type="number" class="form-control form-control-sm" id="editCredit" name="Credit" min="0" step="0.01">
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-1">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnSaveChanges" class="btn btn-sm btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/voucher-edit.js"></script>
}