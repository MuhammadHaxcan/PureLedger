@{
    ViewData["Title"] = "Voucher Entry & Summary";
    var jvId = Context.Request.Query["jvId"].ToString();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-file-invoice me-2"></i>Voucher Entry & Summary</h2>
    </div>

    <div id="alertArea">
        <!-- Alerts will be dynamically added here -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-3">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-search me-2"></i>Voucher Lookup</h6>
        </div>
        <div class="card-body py-2">
            <div class="row mb-2 align-items-end">
                <div class="col-md-5">
                    <label for="voucherIdInput" class="form-label">Enter Voucher ID</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-hashtag"></i></span>
                        <input type="number" id="voucherIdInput" class="form-control no-arrow" min="1" placeholder="Enter voucher ID to search" />
                    </div>
                </div>
                <div class="col-md-3 mt-md-0 mt-2">
                    <button id="fetchVoucherBtn" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i> Fetch Voucher
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="noVoucherMsg" class="alert alert-warning" style="display:none;">
        <i class="fas fa-exclamation-triangle me-2"></i>No voucher found for the entered ID.
    </div>

    <div id="voucherSummaryContainer" style="display:none;">
        <div class="card shadow mb-3">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-list-alt me-2"></i>Voucher Summary
                </h6>
                <div>
                    <button id="editEntireVoucherBtn" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit me-1"></i> Edit Entire Voucher
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0" id="voucherSummaryTable">
                        <thead class="table-primary">
                            <tr>
                                <th>Account Name</th>
                                <th>Description</th>
                                <th>Quantity</th>
                                <th>Rate</th>
                                <th>Discount</th>
                                <th>Discount %</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated by JS -->
                        </tbody>
                        <tfoot>
                            <tr class="table-secondary">
                                <td colspan="6" class="text-end fw-bold">TOTAL</td>
                                <td class="fw-bold" id="totalDebit">0</td>
                                <td class="fw-bold" id="totalCredit">0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Entry Modal -->
<div class="modal fade" id="editEntryModal" tabindex="-1" aria-labelledby="editEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editEntryForm" autocomplete="off">
                <div class="modal-header py-2 bg-primary text-white">
                    <h5 class="modal-title" id="editEntryModalLabel">
                        <i class="fas fa-edit me-2"></i>Edit Journal Entry
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editEntryId" name="EntryId" />
                    <input type="hidden" id="editProjectId" name="ProjectId" />

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <select id="editCategory" name="CategoryId" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Account</label>
                            <select id="editAccount" name="AccountId" class="form-select"></select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <input type="text" class="form-control" id="editDescription" name="Description" placeholder="Enter description">
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-3">
                            <label class="form-label">Quantity</label>
                            <input type="number" class="form-control no-arrow" id="editQuantity" name="Quantity" min="0">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Rate</label>
                            <input type="number" class="form-control no-arrow" id="editRate" name="Rate" min="0" step="0.01">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Discount</label>
                            <input type="number" class="form-control no-arrow" id="editDiscount" name="Discount" min="0" step="0.01">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Discount %</label>
                            <input type="number" class="form-control no-arrow" id="editDiscountPercent" name="DiscountPercent" min="0" max="100" step="0.01">
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Debit</label>
                            <input type="number" class="form-control no-arrow" id="editDebit" name="Debit" min="0" step="0.01">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Credit</label>
                            <input type="number" class="form-control no-arrow" id="editCredit" name="Credit" min="0" step="0.01">
                        </div>
                    </div>

                    <div class="row g-2 mb-2" id="editLocationGroup" style="display:none;">
                        <div class="col-md-12">
                            <label class="form-label">Location</label>
                            <select id="editLocation" name="LocationId" class="form-select"></select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Delivery Challan Entry ID</label>
                            <input type="text" class="form-control" id="editDeliveryChallanEntryId" name="DeliveryChallanEntryId" readonly>
                        </div>
                    </div>

                    <input type="hidden" id="editAccountGroupId" name="AccountGroupId" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                    <button type="submit" id="btnSaveChanges" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/voucher-edit.js" asp-append-version="true"></script>
}

<style>
    /* Fix z-index for dropdowns */
    .dropdown-menu {
        z-index: 9999 !important;
    }

    /* Fix inputs in table */
    .table .form-control-sm,
    .table .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    /* Remove dropdown arrows from all select elements */
    select.form-select {
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        appearance: none !important;
        background-image: none !important;
        padding-right: 0.75rem !important;
    }

        /* For Firefox */
        select.form-select::-ms-expand {
            display: none;
        }

    /* Hide number input spinners (arrows) for all browsers */
    input[type=number].no-arrow::-webkit-inner-spin-button,
    input[type=number].no-arrow::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number].no-arrow {
        -moz-appearance: textfield; /* Firefox */
        appearance: textfield;
    }

    /* Card section padding reduced */
    .card-header.py-2 {
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
    }

    .card-body.py-2 {
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
    }
</style>