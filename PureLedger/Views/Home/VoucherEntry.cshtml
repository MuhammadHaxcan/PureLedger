@{
    ViewBag.Title = "Voucher Entry & Summary";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container py-4">
    <h2>Voucher Lookup</h2>
    <div class="mb-3 row">
        <label for="voucherIdInput" class="col-sm-2 col-form-label">Enter Voucher ID:</label>
        <div class="col-sm-4">
            <input type="number" id="voucherIdInput" class="form-control" min="1" />
        </div>
        <div class="col-sm-2">
            <button id="fetchVoucherBtn" class="btn btn-primary">Fetch Voucher Summary</button>
        </div>
    </div>

    <div id="voucherSummaryContainer" style="display:none;">
        <h3>Voucher Summary</h3>
        <table class="table" id="voucherSummaryTable">
            <thead>
                <tr>
                    <th>Account Name</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Populated by JS -->
            </tbody>
        </table>
    </div>

    <div id="noVoucherMsg" class="alert alert-warning" style="display:none;">
        No voucher found for the entered ID.
    </div>
</div>

<!-- Edit Entry Modal -->
<div class="modal fade" id="editEntryModal" tabindex="-1" aria-labelledby="editEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editEntryForm" autocomplete="off">
                <div class="modal-header">
                    <h5 class="modal-title" id="editEntryModalLabel">Edit Journal Entry</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editEntryId" name="EntryId" />
                    <div class="mb-3">
                        <label for="editAccountName" class="form-label">Account Name</label>
                        <input type="text" class="form-control" id="editAccountName" name="AccountName" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="editDebit" class="form-label">Debit</label>
                        <input type="number" class="form-control" id="editDebit" name="Debit" min="0" step="0.01">
                    </div>
                    <div class="mb-3">
                        <label for="editCredit" class="form-label">Credit</label>
                        <input type="number" class="form-control" id="editCredit" name="Credit" min="0" step="0.01">
                    </div>
                    <!-- Add more fields as needed -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script>
        let currentVoucherId = null;

        // Fetch voucher summary
        $('#fetchVoucherBtn').on('click', function () {
            var voucherId = $('#voucherIdInput').val();
            if (!voucherId) {
                alert('Please enter a voucher ID.');
                return;
            }
            $.get('/Home/GetVoucherSummary', { voucherId: voucherId }, function (data) {
                var tbody = $('#voucherSummaryTable tbody');
                tbody.empty();
                if (data && data.entries && data.entries.length > 0) {
                    currentVoucherId = data.jvId;
                    data.entries.forEach(function (entry) {
                        var row = `<tr data-entry-id="${entry.entryId}">
                            <td>${entry.accountName ?? ''}</td>
                            <td>${entry.debit ?? 0}</td>
                            <td>${entry.credit ?? 0}</td>
                            <td>
                                <button type="button" class="btn btn-primary btn-edit-entry" data-entry-id="${entry.entryId}">Edit</button>
                            </td>
                        </tr>`;
                        tbody.append(row);
                    });
                    $('#voucherSummaryContainer').show();
                    $('#noVoucherMsg').hide();
                } else {
                    $('#voucherSummaryContainer').hide();
                    $('#noVoucherMsg').show();
                }
            });
        });

        // Open modal and load entry data
        $(document).on('click', '.btn-edit-entry', function () {
            var entryId = $(this).data('entry-id');
            $.get('/Home/GetJournalEntry', { entryId: entryId }, function (data) {
                $('#editEntryId').val(data.entryId);
                $('#editAccountName').val(data.accountName);
                $('#editDebit').val(data.debit);
                $('#editCredit').val(data.credit);
                // Add more fields as needed
                var modal = new bootstrap.Modal(document.getElementById('editEntryModal'));
                modal.show();
            });
        });

        // Save changes
        $('#editEntryForm').on('submit', function (e) {
            e.preventDefault();
            var formData = $(this).serialize();
            $.post('/Home/UpdateJournalEntry', formData, function (result) {
                if (result.success) {
                    // Update the row in the table
                    var entryId = $('#editEntryId').val();
                    var row = $('#voucherSummaryTable tbody tr[data-entry-id="' + entryId + '"]');
                    row.find('td').eq(1).text($('#editDebit').val());
                    row.find('td').eq(2).text($('#editCredit').val());
                    bootstrap.Modal.getInstance(document.getElementById('editEntryModal')).hide();
                } else {
                    alert('Error saving entry');
                }
            });
        });
    </script>
}