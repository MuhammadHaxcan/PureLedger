@model PureLedger.ViewModels.BaseVoucherProcessingViewModel
@{
    ViewData["Title"] = "Process Base Voucher";
    var modelStateIsValid = ViewData.ModelState.IsValid;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fas fa-cogs me-2"></i>Process Base Voucher JV-@Model.BaseVoucherId</h2>
        <a href="@Url.Action("BaseVouchers", "Home")" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Base Vouchers
        </a>
    </div>

    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i> Select items to include in the new derived voucher. You can process all or part of each entry.
    </div>

    @if (!modelStateIsValid)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle me-2"></i>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form id="processingForm" method="post" asp-action="CreateDerivedVoucher" asp-controller="Home">
        <input type="hidden" asp-for="BaseVoucherId" />
        <input type="hidden" asp-for="ProjectId" />
        
        <!-- Hidden fields for account entry balancing -->
        <input type="hidden" asp-for="AccountEntryAmount" id="AccountEntryAmount" value="0" />
        <input type="hidden" asp-for="AccountEntryIsDebit" id="AccountEntryIsDebit" value="false" />
        <input type="hidden" asp-for="AccountEntryIncluded" id="AccountEntryIncluded" value="true" />
        
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Available Entries</h6>
                <div>
                    <button type="button" id="selectAllBtn" class="btn btn-sm btn-outline-primary me-1">
                        <i class="fas fa-check-square me-1"></i> Select All
                    </button>
                    <button type="button" id="deselectAllBtn" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-square me-1"></i> Deselect All
                    </button>
                    <button type="button" id="maxQuantityBtn" class="btn btn-sm btn-outline-info ms-1">
                        <i class="fas fa-fill me-1"></i> Max Quantities
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="entriesTable">
                        <thead class="table-primary">
                            <tr>
                                <th width="5%">Select</th>
                                <th width="8%">Entry ID</th>
                                <th width="20%">Account</th>
                                <th width="22%">Description</th>
                                <th width="8%">Available</th>
                                <th width="10%">Process Qty</th>
                                <th width="7%">Rate</th>
                                <th width="10%">Debit</th>
                                <th width="10%">Credit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Entries.Count; i++)
                            {
                                var entry = Model.Entries[i];
                                var isProcessed = entry.IsProcessed;
                                var entryId = entry.EntryId;
                                var availableQty = entry.AvailableQuantity;
                                var isDebit = entry.Debit > 0;
                                var isAccountEntry = entry.AccountGroupId == 1;
                                var rowClass = isProcessed ? "bg-light" : (isAccountEntry ? "table-info" : "");
                                
                                <tr class="entry-row @rowClass" 
                                    data-entry-id="@entryId"
                                    data-is-account="@(isAccountEntry ? "true" : "false")" 
                                    data-is-debit="@(isDebit ? "true" : "false")">
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input entry-select" 
                                               @(isProcessed ? "disabled" : "")
                                               data-is-account="@(isAccountEntry ? "true" : "false")"
                                               @(isAccountEntry && !isProcessed ? "checked" : "") />
                                    </td>
                                    <td>
                                        @entryId
                                        <input type="hidden" name="Entries[@i].EntryId" value="@entryId" />
                                        <input type="hidden" name="Entries[@i].Description" value="@entry.Description" />
                                        <input type="hidden" name="Entries[@i].AccountName" value="@entry.AccountName" />
                                        <input type="hidden" name="Entries[@i].AvailableQuantity" value="@availableQty" />
                                        <input type="hidden" name="Entries[@i].Rate" value="@entry.Rate" />
                                        <input type="hidden" name="Entries[@i].Debit" value="@entry.Debit" />
                                        <input type="hidden" name="Entries[@i].Credit" value="@entry.Credit" />
                                        <input type="hidden" name="Entries[@i].AccountGroupId" value="@entry.AccountGroupId" />
                                        <input type="hidden" name="Entries[@i].AccountId" value="@entry.AccountId" />
                                        <input type="hidden" name="Entries[@i].CategoryId" value="@entry.CategoryId" />
                                        <input type="hidden" name="Entries[@i].Percent" value="@entry.Percent" />
                                        <input type="hidden" name="Entries[@i].Disc" value="@entry.Disc" />
                                        <input type="hidden" name="Entries[@i].Rbp" value="@entry.Rbp" />
                                        
                                        <!-- For tags, if you use them -->
                                        @foreach (var tagId in entry.Tags ?? Enumerable.Empty<int>())
                                        {
                                            <input type="hidden" name="Entries[@i].Tags" value="@tagId" />
                                        }
                                        
                                        <!-- For account entries, add hidden fields -->
                                        @if (isAccountEntry) 
                                        {
                                            <input type="hidden" name="Entries[@i].AccountEntryAmount" value="0" class="account-entry-amount" />
                                            <input type="hidden" name="Entries[@i].AccountEntryIsDebit" value="false" class="account-entry-is-debit" />
                                        }
                                    </td>
                                    <td>
                                        @entry.AccountName
                                        @if (isAccountEntry)
                                        {
                                            <span class="badge bg-info ms-1">Account</span>
                                        }
                                    </td>
                                    <td>@entry.Description</td>
                                    <td>@availableQty</td>
                                    <td>
                                        <input type="number" class="form-control process-qty" 
                                               name="Entries[@i].ProcessQuantity" 
                                               value="@(isAccountEntry && !isProcessed ? availableQty : entry.ProcessQuantity)"
                                               min="0" max="@availableQty" 
                                               @(isProcessed ? "disabled" : "") />
                                    </td>
                                    <td>@entry.Rate</td>
                                    <td class="entry-debit">0</td>
                                    <td class="entry-credit">0</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary fw-bold">
                            <tr>
                                <td colspan="7" class="text-end">Totals:</td>
                                <td id="totalDebit">0</td>
                                <td id="totalCredit">0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label" for="CreditableDate">Creditable Date</label>
                <input class="form-control"
                       id="CreditableDate"
                       name="CreditableDate"
                       type="date"
                       value="@(DateTime.Now.ToString("yyyy-MM-dd"))" required />
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <div>
                <span class="fw-bold me-2">Selected Items:</span>
                <span id="selectedCount" class="badge bg-primary">0</span>
            </div>
            <button type="submit" class="btn btn-success" id="submitBtn">
                <i class="fas fa-share-alt me-1"></i> Create Derived Voucher
            </button>
        </div>  
    </form>
</div>

@section Scripts {
    <script src="~/js/process-voucher.js" asp-append-version="true"></script>
}