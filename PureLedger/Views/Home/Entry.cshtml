@model PureLedger.ViewModels.JournalEntryViewModel
@{
    ViewData["Title"] = ViewBag.Title ?? "Journal Entry";
    var today = DateTime.Now;
    var minDate = today.AddMonths(-1).ToString("dd/MM/yyyy");
    var todayStr = today.ToString("dd/MM/yyyy");
    var projects = ViewBag.Projects as List<PureLedger.Models.Project>;
    var editingVoucherId = ViewBag.EditingVoucherId;
    var isEditMode = editingVoucherId != null;
}

<style>
    /* Basic dropdown positioning */
    .select-container {
        position: relative;
        width: 100%;
    }
    
    .select-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        background: white;
        border: 1px solid #ced4da;
        border-radius: 0.25rem;
        z-index: 9999;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        display: none;
    }
    
    .select-dropdown.show {
        display: block;
    }
    
    .select-option {
        padding: 8px 12px;
        cursor: pointer;
    }
    
    /* Update these styles for hover and selected states */
    .select-option:hover {
        background-color: #f0f7ff;
    }
    
    .select-option.selected {
        background-color: #0d6efd;
        color: white;
        font-weight: 500;
    }
    
    .select-option.filtered-out {
        display: none;
    }
    
    /* Hide original select */
    .select-container select {
        display: none;
    }
    
    /* Make discount input look disabled */
    .disc-input {
        background-color: #e9ecef;
        cursor: not-allowed;
    }
    
    /* Fix table overflow */
    .table-responsive {
        overflow: visible;
    }
</style>

<form id="entryForm" method="post" autocomplete="off" asp-action="Entry" asp-controller="Home">
    @if (isEditMode)
    {
        <input type="hidden" id="editingVoucherId" name="editingVoucherId" value="@editingVoucherId" />
    }

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            <i class="fas fa-@(isEditMode ? "edit" : "book-open") me-2"></i>
            @(isEditMode ? $"Edit Journal Voucher #{editingVoucherId}" : "Journal Entry")
        </h2>
    </div>

    <!-- Alert Area -->
    <div id="alertArea">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(ViewBag.Error)
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Validation Alert (Hidden by default) -->
    <div id="validationAlert" class="alert alert-danger alert-dismissible fade show d-none" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <span id="validationMessage"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Entry Details Card -->
    <div class="card shadow mb-3">
        <div class="card-header py-2">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-info-circle me-2"></i>Entry Details
            </h6>
        </div>
        <div class="card-body py-2">
            <div class="row mb-2">
                <div class="col-md-6 mb-2 mb-md-0">
                    <label class="form-label">Entry Date:</label>
                    <div class="input-group">
                        <span class="input-group-text calendar-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </span>
                        <input class="form-control"
                               name="EntryDate"
                               type="date"
                               id="EntryDate"
                               value="@(Model?.EntryDate.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="ProjectId">Project <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                        <select class="form-select" id="ProjectId" name="ProjectId" required>
                            <option value="">Select Project</option>
                            @if (projects != null)
                            {
                                foreach (var project in projects)
                                {
                                    // compute selection inline
                                    var isSelected = false;
                                    if (Model != null && Model.ProjectId == project.ProjectId)
                                    {
                                        isSelected = true;
                                    }
                                    else if (ViewBag.SelectedProjectId != null && (int)ViewBag.SelectedProjectId == project.ProjectId)
                                    {
                                        isSelected = true;
                                    }
                                    <option value="@project.ProjectId" selected="@(isSelected ? "selected" : null)">@project.ProjectName</option>
                                }
                            }
                        </select>
                    </div>
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Journal Entries Card -->
    <div class="card shadow mb-3">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list-alt me-2"></i>Journal Entries
            </h6>
            <button id="addRowBtn" type="button" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Add Row
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Category <span class="text-danger">*</span></th>
                            <th>Account <span class="text-danger">*</span></th>
                            <th>PKG</th>
                            <th>RBP</th>
                            <th>Description</th>
                            <th>Qty <span class="text-danger product-required-indicator d-none">*</span></th>
                            <th>Rate</th>
                            <th>%</th>
                            <th>Discount</th>
                            <th>Debit</th>
                            <th>Credit</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="entryRows">
                        @if (Model?.Entries != null && Model.Entries.Any())
                        {
                            for (int i = 0; i < Model.Entries.Count; i++)
                            {
                                var entry = Model.Entries[i];
                                <tr id="entryRow-@i" class="entry-row" data-category-id="@entry.CategoryId" data-account-id="@entry.AccountId">
                                    <td>
                                        <div class="select-container">
                                            <input type="text"
                                                   class="form-control form-control-sm select-search category-search"
                                                   placeholder="Search category..."
                                                   autocomplete="off" />
                                            <select class="form-select form-select-sm category-select d-none"
                                                    id="Entries_@(i)_CategoryId"
                                                    name="Entries[@(i)].CategoryId"
                                                    required>
                                                <option value="@entry.CategoryId">Loading category...</option>
                                            </select>
                                            <div class="select-dropdown category-dropdown"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="select-container">
                                            <input type="text"
                                                   class="form-control form-control-sm select-search account-search"
                                                   placeholder="Search account..."
                                                   autocomplete="off" />
                                            <select class="form-select form-select-sm account-select d-none"
                                                    id="Entries_@(i)_AccountId"
                                                    name="Entries[@(i)].AccountId"
                                                    required>
                                                <option value="@entry.AccountId">Loading account...</option>
                                            </select>
                                            <div class="select-dropdown account-dropdown"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm pkg-input"
                                               id="Entries_@(i)_Pkg"
                                               name="Entries[@(i)].Pkg"
                                               type="number"
                                               min="0"
                                               step="1"
                                               placeholder="PKG"
                                               value="@(entry.Pkg)" />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm rbp-select no-arrow"
                                                id="Entries_@(i)_Rbp"
                                                name="Entries[@(i)].Rbp">
                                            <option value="Y" selected="@(entry.Rbp == "Y" ? "selected" : null)">Y</option>
                                            <option value="N" selected="@(entry.Rbp == "N" ? "selected" : null)">N</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm des-input"
                                               id="Entries_@(i)_Des"
                                               name="Entries[@(i)].Des"
                                               placeholder="Description"
                                               value="@entry.Des" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm qty-input"
                                               id="Entries_@(i)_Qty"
                                               name="Entries[@(i)].Qty"
                                               type="number"
                                               min="0"
                                               step="1"
                                               value="@(entry.Qty)" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm rate-input"
                                               id="Entries_@(i)_Rate"
                                               name="Entries[@(i)].Rate"
                                               type="number"
                                               min="0"
                                               step="0.0001"
                                               value="@($"{entry.Rate:F4}")" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm percent-input"
                                               id="Entries_@(i)_Percent"
                                               name="Entries[@(i)].Percent"
                                               type="number"
                                               min="0"
                                               max="100"
                                               step="0.01"
                                               value="@($"{entry.Percent:F2}")" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm disc-input"
                                               id="Entries_@(i)_Disc"
                                               name="Entries[@(i)].Disc"
                                               type="number"
                                               min="0"
                                               step="0.0001"
                                               value="@($"{entry.Disc:F4}")"
                                               readonly
                                               tabindex="-1" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm debit-input"
                                               id="Entries_@(i)_Debit"
                                               name="Entries[@(i)].Debit"
                                               type="number"
                                               min="0"
                                               step="0.0001"
                                               value="@($"{entry.Debit:F4}")" />
                                    </td>
                                    <td>
                                        <input class="form-control form-control-sm credit-input"
                                               id="Entries_@(i)_Credit"
                                               name="Entries[@(i)].Credit"
                                               type="number"
                                               min="0"
                                               step="0.0001"
                                               value="@($"{entry.Credit:F4}")" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm remove-row-btn">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Empty template row when there are no entries -->
                            <tr id="entryRow-0" class="entry-row">
                                <td>
                                    <div class="select-container">
                                        <input type="text"
                                               class="form-control form-control-sm select-search category-search"
                                               placeholder="Search category..."
                                               autocomplete="off" />
                                        <select class="form-select form-select-sm category-select d-none"
                                                id="Entries_0_CategoryId"
                                                name="Entries[0].CategoryId"
                                                required>
                                            <option value="">Select Category</option>
                                        </select>
                                        <div class="select-dropdown category-dropdown"></div>
                                    </div>
                                </td>
                                <td>
                                    <div class="select-container">
                                        <input type="text"
                                               class="form-control form-control-sm select-search account-search"
                                               placeholder="Search account..."
                                               autocomplete="off" />
                                        <select class="form-select form-select-sm account-select d-none"
                                                id="Entries_0_AccountId"
                                                name="Entries[0].AccountId"
                                                required>
                                            <option value="">Select Account</option>
                                        </select>
                                        <div class="select-dropdown account-dropdown"></div>
                                    </div>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm pkg-input"
                                           id="Entries_0_Pkg"
                                           name="Entries[0].Pkg"
                                           type="number"
                                           min="0"
                                           step="1"
                                           placeholder="PKG" />
                                </td>
                                <td>
                                    <select class="form-select form-select-sm rbp-select no-arrow"
                                            id="Entries_0_Rbp"
                                            name="Entries[0].Rbp">
                                        <option value="Y" selected>Y</option>
                                        <option value="N">N</option>
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm des-input"
                                           id="Entries_0_Des"
                                           name="Entries[0].Des"
                                           placeholder="Description" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm qty-input"
                                           id="Entries_0_Qty"
                                           name="Entries[0].Qty"
                                           type="number"
                                           min="0"
                                           step="1"
                                           placeholder="0" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm rate-input"
                                           id="Entries_0_Rate"
                                           name="Entries[0].Rate"
                                           type="number"
                                           min="0"
                                           step="0.0001"
                                           placeholder="0.0000" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm percent-input"
                                           id="Entries_0_Percent"
                                           name="Entries[0].Percent"
                                           type="number"
                                           min="0"  
                                           max="100"
                                           step="0.01"
                                           placeholder="0.00" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm disc-input"
                                           id="Entries_0_Disc"
                                           name="Entries[0].Disc"
                                           type="number"
                                           min="0"
                                           step="0.0001"
                                           placeholder="0.0000"
                                           readonly
                                           tabindex="-1" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm debit-input"
                                           id="Entries_0_Debit"
                                           name="Entries[0].Debit"
                                           type="number"
                                           min="0"
                                           step="0.0001"
                                           placeholder="0.0000" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm credit-input"
                                           id="Entries_0_Credit"
                                           name="Entries[0].Credit"
                                           type="number"
                                           min="0"
                                           step="0.0001"
                                           placeholder="0.0000" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm remove-row-btn">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-secondary">
                            <td colspan="9" class="text-end fw-bold">TOTAL</td>
                            <td class="fw-bold" id="totalDebit">0</td>
                            <td class="fw-bold" id="totalCredit">0</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Additional Details Card -->
    <div class="card shadow mb-3">
        <div class="card-header py-2">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-cog me-2"></i>Additional Details
            </h6>
        </div>
        <div class="card-body py-2">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <label class="form-label" for="CreditDays">Credit Days</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-calendar-day"></i></span>
                        <input class="form-control no-arrow"
                               id="CreditDays"
                               name="CreditDays"
                               type="number"
                               min="0"
                               value="@(Model?.CreditDays ?? 0)" />
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label" for="DueDate">Due Date</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-calendar-check"></i>
                        </span>
                        <input class="form-control"
                               id="DueDate"
                               name="DueDate"
                               type="date"
                               value="@(Model?.DueDate.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                               readonly
                               tabindex="-1"
                               style="background-color: #e9ecef;" />
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label" for="BookerId">Booker</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <select class="form-select" id="BookerId" name="BookerId">
                            @if (ViewBag.Bookers != null && ((List<PureLedger.Models.Booker>)ViewBag.Bookers).Any())
                            {
                                foreach (var booker in ViewBag.Bookers)
                                {
                                    bool isSelected = false;
                                    
                                    if (Model?.BookerId.HasValue == true)
                                    {
                                        // For edit mode - use the model's BookerId
                                        isSelected = Model.BookerId == booker.BookerID;
                                    }
                                    else if (booker == ViewBag.Bookers[0])
                                    {
                                        // For create mode - select first booker by default
                                        isSelected = true;
                                    }
                                    
                                    <option value="@booker.BookerID" selected="@isSelected">
                                        @booker.BookerName
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="">No bookers available</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Base Voucher Checkbox -->
            <div class="row mt-2" id="baseVoucherCheckboxRow" style="display:none;">
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="IsBaseVoucher"
                               name="IsBaseVoucher"
                               value="true"
                               @(Model?.IsBaseVoucher == true ? "checked" : "") />
                        <label class="form-check-label" for="IsBaseVoucher">
                            <span class="fw-bold text-primary">
                                <i class="fas fa-layer-group me-1"></i>Mark as Base Voucher
                            </span>
                            <small class="text-muted ms-2">
                                (Base vouchers can be used to create multiple derived vouchers)
                            </small>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Save Recipe Checkbox and Input -->
            <div class="row mt-2" id="saveRecipeCheckboxRow" style="display:none;">
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="SaveAsRecipe"
                               name="SaveAsRecipe"
                               value="true" />
                        <label class="form-check-label" for="SaveAsRecipe">
                            <span class="fw-bold text-success">
                                <i class="fas fa-bookmark me-1"></i>Save this recipe
                            </span>
                            <small class="text-muted ms-2">
                                (Available only for product entries with at least 2 items)
                            </small>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Recipe Name Input - Hidden by default -->
            <div id="recipeNameContainer" class="row mt-3 d-none">
                <div class="col-md-6">
                    <label class="form-label" for="RecipeName">Recipe Name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-tag"></i></span>
                        <input type="text" 
                               class="form-control" 
                               id="RecipeName" 
                               name="RecipeName" 
                               placeholder="Enter a name for this recipe" />
                    </div>
                    <div class="invalid-feedback">Please provide a name for your recipe</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Actions -->
    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-secondary" onclick="history.back()">
            <i class="fas fa-arrow-left me-1"></i> Back
        </button>
        <div>
            <input type="hidden" id="formAction" name="action" value="submit" />
            <button type="submit" class="btn btn-primary px-4 me-2" id="submitBtn">
                <i class="fas fa-save me-1"></i> @(isEditMode ? "Update Journal Voucher" : "Submit Journal Entry")
            </button>
            <button type="submit" class="btn btn-success px-4" id="submitPrintBtn" name="action" value="submit_print">
                <i class="fas fa-print me-1"></i> @(isEditMode ? "Update and Print" : "Submit and Print")
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/load-data-journal-entry.js" asp-append-version="true"></script>
    <script src="~/js/journal-entry.js" asp-append-version="true"></script>
}