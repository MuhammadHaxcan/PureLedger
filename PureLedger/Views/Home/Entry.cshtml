@model PureLedger.Controllers.JournalEntryViewModel
@{
    ViewData["Title"] = "Journal Entry";
    var today = DateTime.Now.ToString("dd/MM/yyyy");
    var projects = ViewBag.Projects as List<PureLedger.Models.Project>;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div class="container-fluid py-4 px-2">
    <div class="mb-4">
        <h2 class="fw-bold text-primary">Journal Entry</h2>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form id="entryForm" method="post" autocomplete="off" asp-action="Entry" asp-controller="Home">
        <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
                <label class="form-label text-secondary">Date:</label>
                <input class="form-control bg-white border-primary-subtle" name="EntryDate" type="text" value="@today" readonly tabindex="-1" style="pointer-events: none;" />
            </div>
            <div class="col-md-6">
                <label class="form-label text-secondary" for="ProjectId">Select Project</label>
                <select class="form-select bg-white border-primary-subtle" id="ProjectId" name="ProjectId" required>
                    <option value="">Select Project</option>
                    @if (projects != null)
                    {
                        foreach (var p in projects)
                        {
                            var selected = (ViewBag.SelectedProjectId != null && (int)ViewBag.SelectedProjectId == p.ProjectId) ? "selected" : "";
                            <option value="@p.ProjectId" selected="@selected">@p.ProjectName</option>
                        }
                    }
                </select>
                <span asp-validation-for="ProjectId" class="text-danger"></span>
            </div>
        </div>

        <div id="validationAlert" class="alert alert-danger alert-dismissible fade show d-none" role="alert">
            <span id="validationMessage"></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div class="card shadow-sm border-primary-subtle mb-4">
            <div class="card-header bg-primary-subtle d-flex justify-content-between align-items-center">
                <span class="fw-semibold fs-5 text-primary">Entries</span>
                <button id="addRowBtn" type="button" class="btn btn-outline-primary btn-sm">Add More</button>
            </div>
            <div class="card-body bg-light p-0">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-primary">
                            <tr>
                                <th>Category</th>
                                <th>Account</th>
                                <th>Type/PKG</th>
                                <th>RBP</th>
                                <th>Tags</th>
                                <th>Des</th>
                                <th>Qty</th>
                                <th>Rate</th>
                                <th>%</th>
                                <th>Disc</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="entryRows">
                            <tr id="entryRow-0" class="entry-row">
                                <td>
                                    <select class="form-select form-select-sm category-select" 
                                            id="Entries_0__CategoryId" 
                                            name="Entries[0].CategoryId" 
                                            required>
                                        <option value="">Select Category</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm account-select" 
                                            id="Entries_0__AccountId" 
                                            name="Entries[0].AccountId" 
                                            required>
                                        <option value="">Select Account</option>
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm type-input" 
                                           id="Entries_0__Type" 
                                           name="Entries[0].Type" 
                                           readonly />
                                </td>
                                <td>
                                    <select class="form-select form-select-sm rbp-select" 
                                            id="Entries_0__Rbp" 
                                            name="Entries[0].Rbp">
                                        <option value="Y" selected>Y</option>
                                        <option value="N">N</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="form-control form-control-sm tags-input" 
                                            id="Entries_0__Tags" 
                                            name="Entries[0].Tags" 
                                            multiple="multiple" 
                                            style="width: 100%;">
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm des-input" id="Entries_0__Des" name="Entries[0].Des" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm qty-input" id="Entries_0__Qty" name="Entries[0].Qty" type="number" min="0" step="1" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm rate-input" id="Entries_0__Rate" name="Entries[0].Rate" type="number" min="0" step="0.01" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm percent-input" id="Entries_0__Percent" name="Entries[0].Percent" type="number" min="0" max="100" step="0.01" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm disc-input" id="Entries_0__Disc" name="Entries[0].Disc" type="number" min="0" step="1" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm debit-input" id="Entries_0__Debit" name="Entries[0].Debit" type="number" min="0" step="1" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm credit-input" id="Entries_0__Credit" name="Entries[0].Credit" type="number" min="0" step="1" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-row-btn">X</button>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-end fw-bold text-primary">TOTAL</td>
                                <td class="fw-bold text-primary" id="totalDebit">0</td>
                                <td class="fw-bold text-primary" id="totalCredit">0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-4 mb-3 mb-md-0">
                <label class="form-label text-secondary" for="CreditDays">Credit Days</label>
                <input class="form-control bg-white border-primary-subtle" id="CreditDays" name="CreditDays" type="number" min="0" value="0" />
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <label class="form-label text-secondary" for="DueDate">Due Date</label>
                <input class="form-control bg-white border-primary-subtle" id="DueDate" name="DueDate" type="text" value="@today" readonly />
            </div>
            <div class="col-md-4">
                <label class="form-label text-secondary" for="Booker">Booker</label>
                <select class="form-select bg-white border-primary-subtle" id="Booker" name="Booker">
                    <option value="ghazi">ghazi</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary px-4">Submit</button>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/entry.js" asp-append-version="true"></script>
}