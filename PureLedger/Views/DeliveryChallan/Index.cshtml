@model PureLedger.ViewModels.DeliveryChallanFilterViewModel
@{
    ViewData["Title"] = "Delivery Challan";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-truck me-2"></i>Delivery Challan</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Filter Options
            </h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end mb-3">
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="form-label">Since Date</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                        <input type="date" id="sinceDate" class="form-control" value="@(Model?.SinceDate?.ToString("yyyy-MM-dd"))">
                    </div>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="form-label">To Date</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                        <input type="date" id="toDate" class="form-control" value="@(Model?.ToDate?.ToString("yyyy-MM-dd"))">
                    </div>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="form-label">Project</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                        <select id="projectSelect" class="form-select">
                            <option value="">Select Project</option>
                            @if (ViewBag.Projects != null)
                            {
                                foreach (var project in ViewBag.Projects)
                                {
                                    <option value="@project.ProjectId">@project.ProjectName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="form-label">Category</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-list"></i></span>
                        <select id="categorySelect" class="form-select" disabled>
                            <option value="">Select Category</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <label class="form-label">Account</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-file-invoice-dollar"></i></span>
                        <select id="accountSelect" class="form-select" disabled>
                            <option value="">Select Account</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 mb-3 mb-md-0">
                    <button id="goButton" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Filter results...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list-alt me-2"></i>Available Entries
            </h6>
            <div>
                <button id="transferBtn" class="btn btn-info btn-sm">
                    <i class="fas fa-exchange-alt me-1"></i> Transfer
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="entriesTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Account</th>
                            <th>Quantity</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="resultsTable">
                        <!-- Data will be loaded here via JavaScript -->
                        <tr>
                            <td colspan="6" class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delivery Challan Modal -->
<div class="modal fade" id="deliveryChallanModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="deliveryChallanModalTitle">
                    <i class="fas fa-truck me-2"></i>Create Delivery Challan
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info d-none" id="existingChallanMessage">
                    <i class="fas fa-info-circle me-2"></i>This voucher already has a delivery challan. Adding entries will update the existing challan.
                </div>

                <form id="deliveryChallanForm">
                    <input type="hidden" id="dcJournalVoucherId" name="JournalVoucherId" />
                    <input type="hidden" id="dcJournalEntryId" name="JournalEntryId" />
                    <input type="hidden" id="dcChallanId" name="ChallanId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="dcDate" class="form-label">DC Date</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                                <input type="date" class="form-control" id="dcDate" name="ChallanDate" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="dcRemarks" class="form-label">DC Remarks</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-comment"></i></span>
                                <input type="text" class="form-control" id="dcRemarks" name="Remarks" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="dcLocation" class="form-label">Location</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                <select class="form-select" id="dcLocation" name="LocationId" required>
                                    <option value="">Select Location</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="dcStation" class="form-label">Station</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-warehouse"></i></span>
                                <input type="text" class="form-control" id="dcStation" name="Station" />
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="dcOtherRef" class="form-label">Other Reference</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-hashtag"></i></span>
                                <input type="text" class="form-control" id="dcOtherRef" name="OtherRef" />
                            </div>
                        </div>
                    </div>

                    <!-- Add this after the Other Reference field and before the allEntriesView div in the deliveryChallanModal -->
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="includeForCharges">
                                <label class="form-check-label" for="includeForCharges">
                                    <strong>Include FOR Charges</strong>
                                    <small class="text-muted ms-2">(Freight on Road)</small>
                                </label>
                            </div>
                            <div id="forChargesContainer" class="d-none">
                                <label for="forChargesAmount" class="form-label">FOR Charges Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-money-bill-alt"></i></span>
                                    <input type="number" class="form-control" id="forChargesAmount" name="ForAmount" min="0" step="1" value="0">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- All Entries View - This will be populated dynamically -->
                    <div id="allEntriesView" class="d-none">
                        <!-- Dynamic content will be inserted here -->
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="postSingleBtn">
                    <i class="fas fa-check me-1"></i> Post Single
                </button>
                <button type="button" class="btn btn-success" id="postAllBtn">
                    <i class="fas fa-check-double me-1"></i> Post All
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cartage Modal -->
<div class="modal fade" id="cartageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="fas fa-shipping-fast me-2"></i>Add Cartage
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="cartageForm">
                    <input type="hidden" id="cartageJournalVoucherId" />
                    <input type="hidden" id="cartageEntryId" />

                    <div class="mb-3">
                        <label for="transporterAccount" class="form-label">Transporter</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-truck-moving"></i></span>
                            <select id="transporterAccount" class="form-select" required>
                                <option value="">Select Transporter</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="cartageAmount" class="form-label">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-money-bill-wave"></i></span>
                            <input type="number" class="form-control" id="cartageAmount" required min="0" step="0.01">
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="postToCustomer" checked>
                            <label class="form-check-label" for="postToCustomer">
                                Post to Customer Account
                            </label>
                            <small class="form-text text-muted d-block">
                                If checked, cartage will be debited from customer account.
                                If unchecked, it will be debited from delivery item account.
                            </small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="addCartageBtn">
                    <i class="fas fa-plus me-1"></i> Add Cartage & Process
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/delivery-challan.js" asp-append-version="true"></script>
}

<style>
    /* Remove dropdown arrows from all select elements */
    select.form-select {
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        appearance: none !important;
        background-image: none !important;
        padding-right: 0.75rem !important;
    }

        /* For Firefox */
        select.form-select::-ms-expand {
            display: none;
        }

    /* Ensure table row actions are properly aligned */
    .table .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    /* Style for processed items */
    tr.table-success {
        background-color: rgba(40, 167, 69, 0.15) !important;
    }

    /* Style for checkbox labels */
    .form-check-label {
        cursor: pointer;
    }
</style>