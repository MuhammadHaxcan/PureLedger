@model PureLedger.ViewComponents.NavigationViewModel

@{
    // Define navigation items with their controllers and actions
    var navigationMap = new List<(string Title, string Icon, string Controller, List<(string Action, string Title, string Icon)> Actions)>
    {
        ("Home", "fas fa-home", "Home", new List<(string, string, string)> 
        { 
            ("Entry", "New Entry", "fas fa-plus-circle"),
            ("voucherentry", "Edit Entry", "fas fa-edit"),
            ("ModifiedEntries", "Modified Entries", "fas fa-history") 
        }),
        
        ("Metadata", "fas fa-database", "MetaData", new List<(string, string, string)>
        {
            ("Projects", "Projects", "fas fa-project-diagram"),
            ("Categories", "Categories", "fas fa-sitemap"),
            ("Accounts", "Accounts", "fas fa-users"),
            ("Tags", "Tags", "fas fa-tags"),
            ("Locations", "Locations", "fas fa-map-marker-alt")
        }),
        
        ("Reports", "fas fa-chart-bar", "Reporting", new List<(string, string, string)>
        {
            ("SingleDoc", "Single Document", "fas fa-file-alt"),
            ("AgingReport", "Aging Report", "fas fa-calendar-alt"),
            ("AccountReport", "Account Report", "fas fa-user-circle"),
            ("MasterReport", "Master Report", "fas fa-file-invoice")
        })
        
    };
}

<ul class="navbar-nav">
    @foreach (var navItem in navigationMap)
    {
        // First, determine if we should show this section at all
        bool showSection = Model.IsAdmin || Model.AccessibleControllers.Contains(navItem.Controller);
        
        // If not admin and no controller access, check if any specific actions are accessible
        if (!showSection && Model.AccessibleActions.TryGetValue(navItem.Controller, out var accessibleActions))
        {
            // Only show section if user has access to at least one action
            showSection = accessibleActions.Count > 0;
        }
        
        // Special case for DeliveryChallan under Home menu
        bool showDeliveryChallan = false;
        if (navItem.Controller == "Home")
        {
            showDeliveryChallan = Model.IsAdmin || 
                Model.AccessibleControllers.Contains("DeliveryChallan") ||
                (Model.AccessibleActions.TryGetValue("DeliveryChallan", out var challanActions) && 
                challanActions.Contains("Index"));
                
            // If user only has access to DeliveryChallan but nothing in Home, show the Home section anyway
            if (showDeliveryChallan && !showSection)
            {
                showSection = true;
            }
        }
        
        if (showSection)
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle px-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="@navItem.Icon me-1"></i> @navItem.Title
                </a>
                <ul class="dropdown-menu">
                    @foreach (var action in navItem.Actions)
                    {
                        // Use the CanAccessAction helper method to determine if this action should be shown
                        if (Model.CanAccessAction(navItem.Controller, action.Action))
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="@navItem.Controller" asp-action="@action.Action">
                                    <i class="@action.Icon"></i> @action.Title
                                </a>    
                            </li>
                        }
                    }

                    @* Special case for DeliveryChallan under Home menu *@
                    @if (navItem.Controller == "Home" && showDeliveryChallan)
                    {
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="DeliveryChallan" asp-action="Index">
                                <i class="fas fa-truck"></i> Delivery Challan
                            </a>
                        </li>
                    }
                </ul>
            </li>
        }
    }

    @if (Model.IsAdmin)
    {
        <!-- Admin Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle px-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user-shield me-1"></i> Admin
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="fas fa-users-cog"></i> User Management</a></li>
            </ul>
        </li>
    }
</ul>