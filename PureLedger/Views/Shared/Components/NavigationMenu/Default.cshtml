@model PureLedger.ViewComponents.NavigationViewModel

@{
    // Define navigation items with their controllers and actions
    var navigationMap = new List<(string Title, string Icon, string Controller, List<(string Action, string Title, string Icon)> Actions)>
    {
        ("Home", "fas fa-home", "Home", new List<(string, string, string)> 
        { 
            ("Entry", "New Entry", "fas fa-plus-circle"),
            ("VoucherEntry", "Edit Entry", "fas fa-edit"),
            ("BaseVouchers", "Base Vouchers", "fas fa-layer-group"),
            ("MissedEntries", "Missed Entries", "fas fa-exclamation-circle"), // Added Missed Entries
            ("ModifiedEntries", "Modified Entries", "fas fa-history") 
        }),
        
        ("Metadata", "fas fa-database", "MetaData", new List<(string, string, string)>
        {
            ("Projects", "Projects", "fas fa-project-diagram"),
            ("Categories", "Categories", "fas fa-sitemap"),
            ("Accounts", "Accounts", "fas fa-users"),
            ("Locations", "Locations", "fas fa-map-marker-alt")
        }),
        
        ("Reports", "fas fa-chart-bar", "Reporting", new List<(string, string, string)>
        {
            ("SingleDoc", "Single Document", "fas fa-file-alt"),
            ("AgingReport", "Aging Report", "fas fa-calendar-alt"),
            ("AccountReport", "Account Report", "fas fa-user-circle"),
            ("MasterReport", "Master Report", "fas fa-file-invoice"),
            ("ProductReport", "Product Report", "fas fa-box") // Added Product Report
        }),
        
        ("Delivery", "fas fa-truck", "DeliveryChallan", new List<(string, string, string)>
        {
            ("Index", "Delivery Challan", "fas fa-truck")
        })
    };
}

<ul class="navbar-nav">
    @foreach (var navItem in navigationMap)
    {
        // Check if user has access to this controller or any of its actions
        bool hasControllerAccess = Model.CanAccessController(navItem.Controller);
        
        if (hasControllerAccess)
        {
            // Get accessible actions for this controller
            var accessibleActions = navItem.Actions.Where(action => Model.CanAccessAction(navItem.Controller, action.Action)).ToList();
            
            // Only show the menu if there are accessible actions
            if (accessibleActions.Any())
            {
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle px-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="@navItem.Icon me-1"></i> @navItem.Title
                    </a>
                    <ul class="dropdown-menu">
                        @foreach (var action in accessibleActions)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="@navItem.Controller" asp-action="@action.Action">
                                    <i class="@action.Icon me-1"></i> @action.Title
                                </a>    
                            </li>
                        }
                    </ul>
                </li>
            }
        }
    }

    @if (Model.IsAdmin)
    {
        <!-- Admin Dropdown -->
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle px-3" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user-shield me-1"></i> Admin
            </a>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-users-cog me-1"></i> User Management
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Admin" asp-action="ProjectCartageSettings">
                        <i class="fas fa-cogs me-1"></i> Project Cartage Settings
                    </a>
                </li>
            </ul>
        </li>
    }
</ul>