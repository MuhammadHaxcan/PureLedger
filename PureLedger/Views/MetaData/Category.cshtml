@model IEnumerable<PureLedger.Models.Category>
@{
    ViewData["Title"] = "Categories";
    var projects = ViewBag.Projects as List<PureLedger.Models.Project>;
    var accountTypes = ViewBag.AccountTypes as List<PureLedger.Models.AccountType>;
    var newCategory = new PureLedger.Models.Category { AccountTypeId = accountTypes?.FirstOrDefault(at => at.AccountTypeName == "Assets")?.AccountTypeId ?? 0 };
}

<div class="container py-4">
    <h2>Categories</h2>
    <form asp-action="Category" method="post" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label asp-for="@newCategory.CategoryName" class="form-label">Category Name</label>
                <input asp-for="@newCategory.CategoryName" class="form-control" name="CategoryName" required />
                <span asp-validation-for="@newCategory.CategoryName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="@newCategory.ProjectId" class="form-label">Project</label>
                <select asp-for="@newCategory.ProjectId" class="form-select" name="ProjectId" required>
                    <option value="">Select Project</option>
                    @foreach (var p in projects)
                    {
                        <option value="@p.ProjectId">@p.ProjectName</option>
                    }
                </select>
                <span asp-validation-for="@newCategory.ProjectId" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="@newCategory.AccountTypeId" class="form-label">Account Type</label>
                <select asp-for="@newCategory.AccountTypeId" class="form-select" name="AccountTypeId" required>
                    <option value="">Select Account Type</option>
                    @foreach (var at in accountTypes)
                    {
                        <option value="@at.AccountTypeId">@at.AccountTypeName</option>
                    }
                </select>
                <span asp-validation-for="@newCategory.AccountTypeId" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success">Add Category</button>
            </div>
        </div>
    </form>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Project</th>
                <th>Account Type</th>
                <th>Edit</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@($"{c.ProjectId}-{c.AccountTypeId}-{c.CategoryId}")</td>
                <td>@c.CategoryName</td>
                <td>@c.Project?.ProjectName</td>
                <td>@c.AccountType?.AccountTypeName</td>
                <td>
                    <a asp-action="EditCategory" asp-route-id="@c.CategoryId" class="btn btn-sm btn-warning" title="Edit">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>