@model List<PureLedger.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Categories</h2>
        <a asp-action="CreateCategory" class="btn btn-primary" id="addCategoryBtn" title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Category <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="alertArea">
        <!-- Dynamic alerts will be shown here -->
    </div>

    <!-- Simple Project Selection Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-filter me-2"></i>Select Project
            </h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Project <span class="text-danger">*</span></label>
                    <div class="select-container">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                            <input type="text"
                                   class="form-control select-search project-search"
                                   placeholder="Search and select a project..."
                                   autocomplete="off">
                        </div>
                        <select class="form-select d-none" id="projectId">
                            <option value="">Select Project</option>
                        </select>
                        <div class="select-dropdown project-dropdown"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-success" id="generateCategoriesBtn" disabled>
                            <i class="fas fa-play me-1"></i> Generate
                        </button>
                        <button type="button" class="btn btn-secondary" id="clearProjectBtn">
                            <i class="fas fa-times me-1"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Display Card -->
    <div class="card shadow-sm" id="categoriesCard" style="display: none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-list me-2"></i>Categories for <span id="selectedProjectName">Project</span>
            </h6>
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="categorySearch" placeholder="Search categories...">
            </div>
        </div>

        <div class="card-body">
            <div id="loadingIndicator" class="text-center py-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading categories...</span>
                </div>
                <p class="mt-2 text-muted">Loading categories...</p>
            </div>

            <div id="categoriesContainer">
                <div class="table-responsive">
                    <table id="categoriesTable" class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Category Name</th>
                                <th>Account Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="categoriesTableBody">
                            <!-- Categories will be loaded here dynamically -->
                        </tbody>
                    </table>
                </div>
                
                <div id="noCategoriesMessage" class="text-center py-4" style="display: none;">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No categories found for the selected project.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-sm">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-semibold" id="deleteCategoryModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        Are you sure you want to delete the category "<strong id="deleteCategoryName"></strong>"?
                    </p>
                    <div id="deleteCategoryError" class="alert alert-danger d-none"></div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteCategoryForm" asp-action="DeleteCategory" method="post" class="m-0">
                        <input type="hidden" id="deleteCategoryId" name="id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Define API routes for categories
        var routes = {
            getCategoriesByProject: '@Url.Action("GetCategoriesByProjectForView", "MetaData")',
            getAllProjectsForCategories: '@Url.Action("GetAllProjectsForCategories", "MetaData")',
            canDeleteCategory: '@Url.Action("CanDeleteCategory", "MetaData")'
        };
    </script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
}