@model List<PureLedger.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Categories</h2>
        <a asp-action="CreateCategory" class="btn btn-primary" id="addCategoryBtn" title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Category <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">Category List</h6>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="categoriesTable" class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Category Name</th>
                            <th>Project</th>
                            <th>Account Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.CategoryId</td>
                                <td>@category.CategoryName</td>
                                <td>@category.Project?.ProjectName</td>
                                <td>@category.AccountType?.AccountTypeName</td>
                                <td>
                                    <a asp-action="EditCategory"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Initialize DataTable
            $('#categoriesTable').DataTable({
                responsive: true,
                pageLength: 10
            });

            // Keyboard shortcut (Alt + N) for "Add New Category"
            document.addEventListener('keydown', function (e) {
                if (e.altKey && e.key.toLowerCase() === 'n') {
                    e.preventDefault();
                    document.getElementById('addCategoryBtn').click();
                }
            });
        });
    </script>
}