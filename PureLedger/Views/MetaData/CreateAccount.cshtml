@model PureLedger.Models.Account
@{
    ViewData["Title"] = "Create Account";
}

<div class="container-fluid">
    <h2 class="mb-4">Create Account</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Add New Account</h6>
        </div>
        <div class="card-body">
            <form asp-action="CreateAccount" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="AccountName" class="form-label">Account Name</label>
                    <input asp-for="AccountName" class="form-control" />
                    <span asp-validation-for="AccountName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AccountGroupId" class="form-label">Account Group</label>
                    <select asp-for="AccountGroupId" asp-items="ViewBag.AccountGroups" class="form-select" id="accountGroupSelect">
                        <option value="">-- Select Account Group --</option>
                    </select>
                    <span asp-validation-for="AccountGroupId" class="text-danger"></span>
                </div>

                <!-- Account Data Fields (visible when Account Group is "Account") -->
                <div id="accountDataFields" style="display: none;">
                    <h5 class="mt-4 mb-3">Account Details</h5>

                    <div class="mb-3">
                        <label for="AccountData_PhoneNumber" class="form-label">Phone Number</label>
                        <input name="AccountData.PhoneNumber" id="AccountData_PhoneNumber" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="AccountData_Email" class="form-label">Email</label>
                        <input name="AccountData.Email" id="AccountData_Email" class="form-control" type="email" />
                    </div>

                    <div class="mb-3">
                        <label for="AccountData_Address" class="form-label">Address</label>
                        <textarea name="AccountData.Address" id="AccountData_Address" class="form-control"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="AccountData_Area" class="form-label">Area</label>
                            <input name="AccountData.Area" id="AccountData_Area" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="AccountData_City" class="form-label">City</label>
                            <input name="AccountData.City" id="AccountData_City" class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Product Data Fields (visible when Account Group is "Product") -->
                <div id="productDataFields" style="display: none;">
                    <h5 class="mt-4 mb-3">Product Details</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="ProductData_PkgForm" class="form-label">Package Form</label>
                            <input name="ProductData.PkgForm" id="ProductData_PkgForm" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="ProductData_Pkg" class="form-label">Package</label>
                            <input name="ProductData.Pkg" id="ProductData_Pkg" class="form-control" type="number" min="0" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="ProductData_Type" class="form-label">Type</label>
                            <input name="ProductData.Type" id="ProductData_Type" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="ProductData_SaleRate" class="form-label">Sale Rate</label>
                            <input name="ProductData.SaleRate" id="ProductData_SaleRate" class="form-control" type="number" min="0" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Accounts" class="btn btn-secondary">Back to List</a>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            // Handle showing/hiding account type specific fields
            $('#accountGroupSelect').change(function() {
                var selectedText = $(this).find('option:selected').text().toLowerCase().trim();

                if (selectedText === 'account') {
                    $('#accountDataFields').show();
                    $('#productDataFields').hide();
                } else if (selectedText === 'product') {
                    $('#productDataFields').show();
                    $('#accountDataFields').hide();
                } else {
                    $('#accountDataFields').hide();
                    $('#productDataFields').hide();
                }
            });

            // Trigger change event on page load to set initial visibility
            $('#accountGroupSelect').trigger('change');
        });
    </script>
}