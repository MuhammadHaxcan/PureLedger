@model List<PureLedger.Models.Project>
@{
    ViewData["Title"] = "Projects";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Projects</h2>
        <a asp-action="CreateProject" class="btn btn-primary" id="addProjectBtn" title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Project <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="alertArea">
        <!-- Dynamic alerts will be shown here -->
    </div>

    <!-- Projects Display Card -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-project-diagram me-2"></i>All Projects
            </h6>
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="projectSearch" placeholder="Search projects...">
            </div>
        </div>

        <div class="card-body">
            <div id="projectsContainer">
                <div class="table-responsive">
                    <table id="projectsTable" class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Project Name</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="projectsTableBody">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var project in Model)
                                {
                                    <tr>
                                        <td>@project.ProjectId</td>
                                        <td>@project.ProjectName</td>
                                        <td>
                                            <a asp-action="EditProject" 
                                               asp-route-id="@project.ProjectId" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit me-1"></i>Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (Model == null || !Model.Any())
                {
                    <div id="noProjectsMessage" class="text-center py-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No projects found. Create your first project to get started.</p>
                    </div>
                }
                else
                {
                    <div id="noProjectsMessage" class="text-center py-4" style="display: none;">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No projects match your search criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Keyboard shortcut (Alt + N) for "Add New Project"
            document.addEventListener('keydown', function (e) {
                if (e.altKey && e.key.toLowerCase() === 'n') {
                    e.preventDefault();
                    const addBtn = document.getElementById('addProjectBtn');
                    if (addBtn) {
                        addBtn.click();
                    }
                }
            });

            // Project search functionality
            const projectSearch = document.getElementById('projectSearch');
            if (projectSearch) {
                projectSearch.addEventListener('input', debounce(filterProjects, 250));
            }

            function filterProjects() {
                const searchTerm = projectSearch.value.toLowerCase();
                const rows = document.querySelectorAll('#projectsTableBody tr');
                const noProjectsMessage = document.getElementById('noProjectsMessage');
                let visibleCount = 0;
                
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const shouldShow = text.includes(searchTerm);
                    row.style.display = shouldShow ? '' : 'none';
                    if (shouldShow) visibleCount++;
                });
                
                // Show/hide no results message
                if (noProjectsMessage) {
                    if (visibleCount === 0 && rows.length > 0) {
                        noProjectsMessage.style.display = 'block';
                        noProjectsMessage.innerHTML = `
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No projects match your search criteria.</p>
                        `;
                    } else {
                        noProjectsMessage.style.display = 'none';
                    }
                }
            }

            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }
        });
    </script>
}