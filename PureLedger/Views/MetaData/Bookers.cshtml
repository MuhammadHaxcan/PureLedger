@model List<PureLedger.Models.Booker>
@{
    ViewData["Title"] = "Bookers";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Bookers</h2>
        <a asp-action="CreateBooker" class="btn btn-primary" id="addBookerBtn" title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Booker <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="alertArea">
        <!-- Dynamic alerts will be shown here -->
    </div>

    <!-- Bookers Display Card -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-user-tie me-2"></i>All Bookers
            </h6>
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="bookerSearch" placeholder="Search bookers...">
            </div>
        </div>

        <div class="card-body">
            <div id="bookersContainer">
                <div class="table-responsive">
                    <table id="bookersTable" class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Booker Name</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="bookersTableBody">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var booker in Model)
                                {
                                    <tr data-booker-id="@booker.BookerID">
                                        <td>@booker.BookerID</td>
                                        <td>@booker.BookerName</td>
                                        <td>
                                            <span class="badge status-badge @(booker.IsEnabled ? "bg-success" : "bg-danger")">
                                                <i class="fas @(booker.IsEnabled ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                                                @(booker.IsEnabled ? "Enabled" : "Disabled")
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-action="EditBooker" 
                                               asp-route-id="@booker.BookerID" 
                                               class="btn btn-sm btn-outline-primary me-1">
                                                <i class="fas fa-edit me-1"></i>Edit
                                            </a>
                                            
                                            <button type="button"
                                                    class="btn btn-sm toggle-status-btn @(booker.IsEnabled ? "btn-outline-warning" : "btn-outline-success")"
                                                    data-booker-id="@booker.BookerID"
                                                    data-booker-name="@booker.BookerName"
                                                    data-current-status="@booker.IsEnabled.ToString().ToLower()"
                                                    title="@(booker.IsEnabled ? "Disable" : "Enable") this booker">
                                                <i class="fas @(booker.IsEnabled ? "fa-ban" : "fa-check") me-1"></i>@(booker.IsEnabled ? "Disable" : "Enable")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (Model == null || !Model.Any())
                {
                    <div id="noBookersMessage" class="text-center py-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No bookers found. Create your first booker to get started.</p>
                    </div>
                }
                else
                {
                    <div id="noBookersMessage" class="text-center py-4" style="display: none;">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No bookers match your search criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Status Change Confirmation Modal -->
    <div class="modal fade" id="statusChangeModal" tabindex="-1" aria-labelledby="statusChangeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-sm">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-semibold" id="statusChangeModalLabel">Confirm Status Change</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        Are you sure you want to <strong id="actionText"></strong> the booker "<strong id="bookerName"></strong>"?
                    </p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn" id="confirmStatusChange">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Keyboard shortcut (Alt + N) for "Add New Booker"
            document.addEventListener('keydown', function (e) {
                if (e.altKey && e.key.toLowerCase() === 'n') {
                    e.preventDefault();
                    const addBtn = document.getElementById('addBookerBtn');
                    if (addBtn) {
                        addBtn.click();
                    }
                }
            });

            // Booker search functionality
            const bookerSearch = document.getElementById('bookerSearch');
            if (bookerSearch) {
                bookerSearch.addEventListener('input', debounce(filterBookers, 250));
            }

            // Setup status toggle handlers
            setupStatusToggleHandlers();

            function filterBookers() {
                const searchTerm = bookerSearch.value.toLowerCase();
                const rows = document.querySelectorAll('#bookersTableBody tr');
                const noBookersMessage = document.getElementById('noBookersMessage');
                let visibleCount = 0;
                
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const shouldShow = text.includes(searchTerm);
                    row.style.display = shouldShow ? '' : 'none';
                    if (shouldShow) visibleCount++;
                });
                
                // Show/hide no results message
                if (noBookersMessage) {
                    if (visibleCount === 0 && rows.length > 0) {
                        noBookersMessage.style.display = 'block';
                        noBookersMessage.innerHTML = `
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No bookers match your search criteria.</p>
                        `;
                    } else {
                        noBookersMessage.style.display = 'none';
                    }
                }
            }

            function setupStatusToggleHandlers() {
                document.querySelectorAll('.toggle-status-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const bookerId = this.dataset.bookerId;
                        const bookerName = this.dataset.bookerName;
                        const currentStatus = this.dataset.currentStatus === 'true';
                        
                        const actionText = currentStatus ? 'disable' : 'enable';
                        const actionTextCapitalized = currentStatus ? 'Disable' : 'Enable';
                        
                        // Update modal content
                        document.getElementById('actionText').textContent = actionText;
                        document.getElementById('bookerName').textContent = bookerName;
                        
                        const confirmBtn = document.getElementById('confirmStatusChange');
                        confirmBtn.className = `btn ${currentStatus ? 'btn-warning' : 'btn-success'}`;
                        confirmBtn.textContent = actionTextCapitalized;
                        
                        // Store data for confirmation
                        confirmBtn.dataset.bookerId = bookerId;
                        confirmBtn.dataset.bookerName = bookerName;
                        confirmBtn.dataset.currentStatus = currentStatus;
                        
                        // Show modal
                        new bootstrap.Modal(document.getElementById('statusChangeModal')).show();
                    });
                });

                // Handle confirm button click
                document.getElementById('confirmStatusChange').addEventListener('click', function() {
                    const bookerId = this.dataset.bookerId;
                    const bookerName = this.dataset.bookerName;
                    const currentStatus = this.dataset.currentStatus === 'true';
                    
                    toggleBookerStatus(bookerId, bookerName, currentStatus);
                    
                    // Hide modal
                    bootstrap.Modal.getInstance(document.getElementById('statusChangeModal')).hide();
                });
            }

            async function toggleBookerStatus(bookerId, bookerName, currentStatus) {
                try {
                    // Show loading state
                    const button = document.querySelector(`[data-booker-id="${bookerId}"].toggle-status-btn`);
                    const originalContent = button.innerHTML;
                    button.disabled = true;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Updating...';

                    const response = await fetch('/MetaData/ToggleBookerStatusAjax', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: `id=${bookerId}`
                    });

                    const result = await response.json();

                    if (result.success) {
                        // Update the UI
                        updateBookerRowStatus(bookerId, result.isEnabled, bookerName);
                        showAlert('success', result.message);
                    } else {
                        showAlert('danger', result.message);
                        // Restore button state
                        button.disabled = false;
                        button.innerHTML = originalContent;
                    }
                } catch (error) {
                    console.error('Error toggling booker status:', error);
                    showAlert('danger', 'An error occurred while updating the booker status.');
                    
                    // Restore button state
                    const button = document.querySelector(`[data-booker-id="${bookerId}"].toggle-status-btn`);
                    button.disabled = false;
                    button.innerHTML = originalContent;
                }
            }

            function updateBookerRowStatus(bookerId, isEnabled, bookerName) {
                const row = document.querySelector(`tr[data-booker-id="${bookerId}"]`);
                if (!row) return;

                // Update status badge
                const statusBadge = row.querySelector('.status-badge');
                statusBadge.className = `badge status-badge ${isEnabled ? 'bg-success' : 'bg-danger'}`;
                statusBadge.innerHTML = `
                    <i class="fas ${isEnabled ? 'fa-check-circle' : 'fa-times-circle'} me-1"></i>
                    ${isEnabled ? 'Enabled' : 'Disabled'}
                `;

                // Update toggle button
                const toggleBtn = row.querySelector('.toggle-status-btn');
                toggleBtn.className = `btn btn-sm toggle-status-btn ${isEnabled ? 'btn-outline-warning' : 'btn-outline-success'}`;
                toggleBtn.innerHTML = `
                    <i class="fas ${isEnabled ? 'fa-ban' : 'fa-check'} me-1"></i>${isEnabled ? 'Disable' : 'Enable'}
                `;
                toggleBtn.title = `${isEnabled ? 'Disable' : 'Enable'} this booker`;
                toggleBtn.dataset.currentStatus = isEnabled.toString();
                toggleBtn.disabled = false;
            }

            function showAlert(type, message) {
                const alertArea = document.getElementById('alertArea');
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
                alertDiv.innerHTML = `
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                
                alertArea.appendChild(alertDiv);
                
                // Auto-dismiss after 5 seconds
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            }

            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }
        });
    </script>
}

<style>
    .status-badge {
        font-size: 0.85em;
        padding: 0.5em 0.75em;
    }

    .toggle-status-btn {
        transition: all 0.2s ease-in-out;
    }

    .toggle-status-btn:hover {
        transform: translateY(-1px);
    }

    .toggle-status-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    tr[data-booker-id] {
        transition: background-color 0.3s ease;
    }

    .alert {
        border-left: 4px solid;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    .alert-danger {
        border-left-color: #dc3545;
    }
</style>
