@model PureLedger.Models.Tag
@{
    ViewData["Title"] = "Delete Tag";
}

<div class="container-fluid">
    <h2 class="mb-4">Delete Tag</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Confirm Deletion</h6>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h5>Are you sure you want to delete this tag?</h5>
                <p>This action cannot be undone.</p>
            </div>

            <dl class="row">
                <dt class="col-sm-3">Tag ID</dt>
                <dd class="col-sm-9">@Model.TagId</dd>

                <dt class="col-sm-3">Tag Name</dt>
                <dd class="col-sm-9">@Model.TagName</dd>
            </dl>

            <form asp-action="DeleteTagConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.TagId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Tags" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>