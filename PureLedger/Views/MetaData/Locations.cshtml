@model List<PureLedger.Models.Location>
@{
    ViewData["Title"] = "Locations";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Locations</h2>
        <a asp-action="CreateLocation" class="btn btn-primary" id="addLocationBtn" title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Location <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="alertArea">
        <!-- Dynamic alerts will be shown here -->
    </div>

    <!-- Locations Display Card -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-map-marker-alt me-2"></i>All Locations
            </h6>
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="locationSearch" placeholder="Search locations...">
            </div>
        </div>

        <div class="card-body">
            <div id="locationsContainer">
                <div class="table-responsive">
                    <table id="locationsTable" class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Location Name</th>
                                <th>Phone</th>
                                <th>Region</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="locationsTableBody">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var location in Model)
                                {
                                    <tr>
                                        <td>@location.LocationId</td>
                                        <td>@location.LocationName</td>
                                        <td>@location.Phone</td>
                                        <td>@location.Region</td>
                                        <td>
                                            <a asp-action="EditLocation" 
                                               asp-route-id="@location.LocationId" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-edit me-1"></i>Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (Model == null || !Model.Any())
                {
                    <div id="noLocationsMessage" class="text-center py-4">
                        <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No locations found. Create your first location to get started.</p>
                    </div>
                }
                else
                {
                    <div id="noLocationsMessage" class="text-center py-4" style="display: none;">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No locations match your search criteria.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Keyboard shortcut (Alt + N) for "Add New Location"
            document.addEventListener('keydown', function (e) {
                if (e.altKey && e.key.toLowerCase() === 'n') {
                    e.preventDefault();
                    const addBtn = document.getElementById('addLocationBtn');
                    if (addBtn) {
                        addBtn.click();
                    }
                }
            });

            // Location search functionality
            const locationSearch = document.getElementById('locationSearch');
            if (locationSearch) {
                locationSearch.addEventListener('input', debounce(filterLocations, 250));
            }

            function filterLocations() {
                const searchTerm = locationSearch.value.toLowerCase();
                const rows = document.querySelectorAll('#locationsTableBody tr');
                const noLocationsMessage = document.getElementById('noLocationsMessage');
                let visibleCount = 0;
                
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const shouldShow = text.includes(searchTerm);
                    row.style.display = shouldShow ? '' : 'none';
                    if (shouldShow) visibleCount++;
                });
                
                // Show/hide no results message
                if (noLocationsMessage) {
                    if (visibleCount === 0 && rows.length > 0) {
                        noLocationsMessage.style.display = 'block';
                        noLocationsMessage.innerHTML = `
                            <i class="fas fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No locations match your search criteria.</p>
                        `;
                    } else {
                        noLocationsMessage.style.display = 'none';
                    }
                }
            }

            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }
        });
    </script>
}
