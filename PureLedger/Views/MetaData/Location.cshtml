@model IEnumerable<PureLedger.Models.Location>
@{
    ViewData["Title"] = "Locations";
}

<div class="container mt-4">
    <h1>Locations</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Add New Location</h5>
                </div>
                <div class="card-body">
                    <form id="locationForm" asp-action="Location" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="Name" class="form-label">Name</label>
                            <input name="Name" id="Name" class="form-control" />
                            <span class="text-danger field-validation-error" data-valmsg-for="Name"></span>
                        </div>
                        <div class="mb-3">
                            <label for="Phone" class="form-label">Phone</label>
                            <input name="Phone" id="Phone" class="form-control" />
                            <span class="text-danger field-validation-error" data-valmsg-for="Phone"></span>
                        </div>
                        <div class="mb-3">
                            <label for="Region" class="form-label">Region</label>
                            <input name="Region" id="Region" class="form-control" />
                            <span class="text-danger field-validation-error" data-valmsg-for="Region"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Add Location</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>All Locations</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th>Region</th>
                            </tr>
                        </thead>
                        <tbody id="locationList">
                            @foreach (var location in Model)
                            {
                                <tr>
                                    <td>@location.Name</td>
                                    <td>@location.Phone</td>
                                    <td>@location.Region</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/location.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}