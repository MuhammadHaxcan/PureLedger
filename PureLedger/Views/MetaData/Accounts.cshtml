@model List<PureLedger.Models.Account>
@{
    ViewData["Title"] = "Accounts";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Accounts</h2>
        <a asp-action="CreateAccount"
           class="btn btn-primary"
           id="addAccountBtn"
           title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Account <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">Account List</h6>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="accountsTable" class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Account Name</th>
                            <th>Category</th>
                            <th>Project</th>
                            <th>Account Group</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Model)
                        {
                            <tr>
                                <td>@account.AccountId</td>
                                <td>@account.AccountName</td>
                                <td>@account.Category?.CategoryName</td>
                                <td>@account.Category?.Project?.ProjectName</td>
                                <td>@account.AccountGroup?.AccountGroupName</td>
                                <td>
                                    <a asp-action="EditAccount"
                                       asp-route-id="@account.AccountId"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger delete-account-btn"
                                            data-id="@account.AccountId"
                                            data-name="@account.AccountName">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-sm">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-semibold" id="deleteAccountModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    Are you sure you want to delete the account "<strong id="deleteAccountName"></strong>"?
                </p>
                <div id="deleteAccountError" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteAccountForm" asp-action="DeleteAccount" method="post" class="m-0">
                    <input type="hidden" id="deleteAccountId" name="id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Initialize DataTable
            $('#accountsTable').DataTable({
                responsive: true,
                pageLength: 10
            });

            // Shortcut: Alt + N to open Create Account
            document.addEventListener('keydown', function (e) {
                if (e.altKey && e.key.toLowerCase() === 'n') {
                    e.preventDefault();
                    document.getElementById('addAccountBtn').click();
                }
            });

            // Handle Delete Account Button
            document.querySelectorAll('.delete-account-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const accountId = this.dataset.id;
                    const accountName = this.dataset.name;

                    const nameEl = document.getElementById('deleteAccountName');
                    const idEl = document.getElementById('deleteAccountId');
                    const errorEl = document.getElementById('deleteAccountError');
                    const formEl = document.getElementById('deleteAccountForm');

                    nameEl.textContent = accountName;
                    idEl.value = accountId;
                    errorEl.classList.add('d-none');
                    formEl.style.display = '';

                    // Check if account can be deleted
                    fetch(`@Url.Action("CanDeleteAccount")/${accountId}`)
                        .then(response => response.json())
                        .then(result => {
                            if (result.canDelete) {
                                new bootstrap.Modal(document.getElementById('deleteAccountModal')).show();
                            } else {
                                errorEl.textContent = result.message;
                                errorEl.classList.remove('d-none');
                                formEl.style.display = 'none';
                                new bootstrap.Modal(document.getElementById('deleteAccountModal')).show();
                            }
                        })
                        .catch(err => {
                            errorEl.textContent = 'An error occurred while checking if the account can be deleted.';
                            errorEl.classList.remove('d-none');
                            formEl.style.display = 'none';
                            new bootstrap.Modal(document.getElementById('deleteAccountModal')).show();
                        });
                });
            });
        });
    </script>
}