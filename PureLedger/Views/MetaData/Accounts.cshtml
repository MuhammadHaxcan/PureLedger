@model List<PureLedger.Models.Account>
@{
    ViewData["Title"] = "Accounts";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Accounts</h2>
        <a asp-action="CreateAccount" class="btn btn-primary" id="addAccountBtn" title="Shortcut: Alt + N">
            <i class="fas fa-plus me-1"></i> Add New Account <span class="text-muted small">[Alt+N]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="alertArea">
        <!-- Dynamic alerts will be shown here -->
    </div>

    <!-- Project and Category Selection Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-filter me-2"></i>Select Project & Category
            </h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Project <span class="text-danger">*</span></label>
                    <div class="select-container project-container">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                            <input type="text"
                                   class="form-control select-search project-search"
                                   placeholder="Search and select a project..."
                                   autocomplete="off">
                        </div>
                        <select class="form-select d-none" id="projectId">
                            <option value="">Select Project</option>
                        </select>
                        <div class="select-dropdown project-dropdown"></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <div class="select-container category-container">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-list"></i></span>
                            <input type="text"
                                   class="form-control select-search category-search"
                                   placeholder="Select a project first..."
                                   autocomplete="off"
                                   disabled>
                        </div>
                        <select class="form-select d-none" id="categoryId" disabled>
                            <option value="">All Categories</option>
                        </select>
                        <div class="select-dropdown category-dropdown"></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-success" id="generateAccountsBtn" disabled>
                            <i class="fas fa-play me-1"></i> Generate
                        </button>
                        <button type="button" class="btn btn-secondary" id="clearSelectionBtn">
                            <i class="fas fa-times me-1"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accounts Display Card -->
    <div class="card shadow-sm" id="accountsCard" style="display: none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-users me-2"></i>Accounts for <span id="selectedProjectName">Project</span>
                <span id="selectedCategoryInfo"></span>
            </h6>
            <div class="input-group" style="width: 250px;">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" class="form-control" id="accountSearch" placeholder="Search accounts...">
            </div>
        </div>

        <div class="card-body">
            <div id="loadingIndicator" class="text-center py-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading accounts...</span>
                </div>
                <p class="mt-2 text-muted">Loading accounts...</p>
            </div>

            <div id="accountsContainer">
                <div class="table-responsive">
                    <table id="accountsTable" class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Account Name</th>
                                <th>Category</th>
                                <th>Account Group</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="accountsTableBody">
                            <!-- Accounts will be loaded here dynamically -->
                        </tbody>
                    </table>
                </div>
                
                <div id="noAccountsMessage" class="text-center py-4" style="display: none;">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No accounts found for the selected criteria.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-sm">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-semibold" id="deleteAccountModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        Are you sure you want to delete the account "<strong id="deleteAccountName"></strong>"?
                    </p>
                    <div id="deleteAccountError" class="alert alert-danger d-none"></div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form id="deleteAccountForm" asp-action="DeleteAccount" method="post" class="m-0">
                        <input type="hidden" id="deleteAccountId" name="id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Change Confirmation Modal -->
    <div class="modal fade" id="statusChangeModal" tabindex="-1" aria-labelledby="statusChangeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-sm">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-semibold" id="statusChangeModalLabel">Confirm Status Change</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        Are you sure you want to <strong id="actionText"></strong> the account "<strong id="itemName"></strong>"?
                    </p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn" id="confirmStatusChange">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Define API routes for accounts
        var routes = {
            getAllProjectsForAccounts: '@Url.Action("GetAllProjectsForAccounts", "MetaData")',
            getCategoriesByProject: '@Url.Action("GetCategoriesByProject", "MetaData")',
            getAccountsByCriteria: '@Url.Action("GetAccountsByCriteria", "MetaData")',
            canDeleteAccount: '@Url.Action("CanDeleteAccount", "MetaData")'
        };
    </script>
    <script src="~/js/accounts.js" asp-append-version="true"></script>
}

<style>
    .status-badge {
        font-size: 0.85em;
        padding: 0.5em 0.75em;
    }

    .toggle-status-btn {
        transition: all 0.2s ease-in-out;
    }

    .toggle-status-btn:hover {
        transform: translateY(-1px);
    }

    .toggle-status-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    tr[data-account-id] {
        transition: background-color 0.3s ease;
    }

    .alert {
        border-left: 4px solid;
    }

    .alert-success {
        border-left-color: #28a745;
    }

    .alert-danger {
        border-left-color: #dc3545;
    }
</style>