@model IEnumerable<PureLedger.Models.Tag>
@{
    ViewData["Title"] = "Manage Tags";
}

<div class="container-fluid py-4 px-2">
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <h2 class="fw-bold text-primary">Manage Tags</h2>
    </div>
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="row">
        <div class="col-md-4">
            <div class="card border-primary-subtle shadow-sm">
                <div class="card-header bg-primary-subtle">
                    <h5 class="card-title text-primary mb-0">Add New Tag</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Tag" method="post">
                        <div class="mb-3">
                            <label class="form-label" for="TagName">Tag Name</label>
                            <input type="text" class="form-control" id="TagName" name="TagName" required maxlength="50" />
                            <span class="text-danger" asp-validation-for="@(new PureLedger.Models.Tag()).TagName"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Add Tag</button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card border-primary-subtle shadow-sm">
                <div class="card-header bg-primary-subtle">
                    <h5 class="card-title text-primary mb-0">Tags</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>ID</th>
                                    <th>Tag Name</th>
                                    <th width="100">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    foreach (var tag in Model)
                                    {
                                        <tr>
                                            <td>@tag.TagId</td>
                                            <td>@tag.TagName</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-danger delete-tag-btn" 
                                                        data-id="@tag.TagId" data-name="@tag.TagName">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center">No tags found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete tag: <span id="tagNameToDelete" class="fw-bold"></span>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/tag.js"></script>
}