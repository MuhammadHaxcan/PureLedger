@model PureLedger.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Create User";
    
    // Get all controllers and their actions from ViewBag
    var controllerActionsMap = ViewBag.ControllerActions as Dictionary<string, List<string>> 
        ?? new Dictionary<string, List<string>>();
}

<div class="container-fluid">
    <h2 class="mb-4">Create User</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">New User</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Username" class="form-label">Username</label>
                            <input asp-for="Username" class="form-control" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-check">
                            <input asp-for="IsAdmin" class="form-check-input" />
                            <label asp-for="IsAdmin" class="form-check-label">Is Admin</label>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Assign Projects</label>
                    <div class="card">
                        <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var project in ViewBag.Projects)
                            {
                                <div class="form-check">
                                    <input type="checkbox" name="ProjectIds" value="@project.ProjectId"
                                           class="form-check-input" />
                                    <label class="form-check-label">@project.ProjectName</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Controller Access</label>
                    <div class="card">
                        <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                            @foreach (var controller in ViewBag.Controllers ?? new string[] { "Home", "MetaData", "Reporting", "DeliveryChallan" })
                            {
                                <div class="mb-2">
                                    <div class="form-check">
                                        <input type="checkbox" name="ControllerAccess" id="controller_@controller" 
                                               value="@controller" class="form-check-input controller-checkbox" 
                                               data-controller="@controller" />
                                        <label class="form-check-label fw-bold" for="controller_@controller">@controller</label>
                                    </div>
                                    
                                    <!-- Show actions for this controller -->
                                    @if (controllerActionsMap.TryGetValue(controller, out List<string> actions))
                                    {
                                        <div class="ms-4 mt-2 actions-container" id="actions_@controller">
                                            @foreach (var action in actions)
                                            {
                                                <div class="form-check">
                                                    <input type="checkbox" name="ActionAccess" id="action_@(controller)_@(action)" 
                                                           value="@(controller)|@(action)" class="form-check-input action-checkbox" 
                                                           data-controller="@controller" data-action="@action" />
                                                    <label class="form-check-label" for="action_@(controller)_@(action)">@action</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Create
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        $(document).ready(function() {
            // Toggle action checkboxes based on controller checkbox
            $('.controller-checkbox').change(function() {
                var controllerId = $(this).data('controller');
                var isChecked = $(this).prop('checked');
                
                // Find all action checkboxes for this controller
                $('input.action-checkbox[data-controller="' + controllerId + '"]').prop('checked', isChecked);
                
                // Toggle visibility of actions container
                $('#actions_' + controllerId).slideToggle(isChecked);
            });
            
            // Initialize visibility
            $('.controller-checkbox').each(function() {
                var controllerId = $(this).data('controller');
                var isChecked = $(this).prop('checked');
                
                if (!isChecked) {
                    $('#actions_' + controllerId).hide();
                }
            });
            
            // When an action is checked, ensure its controller is checked too
            $('.action-checkbox').change(function() {
                var controllerId = $(this).data('controller');
                
                if ($(this).prop('checked')) {
                    $('#controller_' + controllerId).prop('checked', true);
                }
            });
        });
    </script>
}