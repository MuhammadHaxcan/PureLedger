@model PureLedger.Models.ProjectCartageSettings
@{
    ViewData["Title"] = "Project Cartage Settings";
    var projects = ViewBag.Projects as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-cog me-2"></i>Project Cartage Settings</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-truck me-2"></i>Cartage Configuration
            </h6>
        </div>
        <div class="card-body">
            <form asp-action="ProjectCartageSettings" method="post" id="cartage-settings-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Project <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                        <select asp-for="ProjectId" class="form-select" asp-items="@projects" id="ProjectId" required>
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>
                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">FOR Expense Category</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-list"></i></span>
                        <select class="form-select" id="ForExpenseCategoryId" name="ForExpenseCategoryId">
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">FOR Expense Account</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-file-invoice"></i></span>
                        <select asp-for="ForExpenseAccountId" class="form-select" id="ForExpenseAccountId">
                            <option value="">-- Select Account --</option>
                        </select>
                    </div>
                    <span asp-validation-for="ForExpenseAccountId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Cartage Transporter Category <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-truck-loading"></i></span>
                        <select asp-for="CartageTransporterCategoryId" class="form-select" id="CartageTransporterCategoryId" required>
                            <option value="">-- Select Category --</option>
                        </select>
                    </div>
                    <span asp-validation-for="CartageTransporterCategoryId" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save Settings
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Add this before loading project-cartage-settings.js
        var routes = {
            getCategoriesByProject: '@Url.Action("GetCategoriesByProject", "Admin")',
            getAccountsByCategory: '@Url.Action("GetAccountsByCategory", "Admin")',
            getProjectCartageSettingsByProject: '@Url.Action("GetProjectCartageSettingsByProject", "Admin")',
            getCategoryForAccount: '@Url.Action("GetCategoryForAccount", "Admin")'
        };
    </script>
    <script src="~/js/project-cartage-settings.js" asp-append-version="true"></script>
}