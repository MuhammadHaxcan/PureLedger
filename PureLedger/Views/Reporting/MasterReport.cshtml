@model PureLedger.ViewModels.MasterReportPageViewModel
@using System
@{
    ViewData["Title"] = "Master Report";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container-fluid mt-4">
    <h2>Master Report</h2>
    <div class="card mb-4">
        <div class="card-body">
            <form id="masterReportForm">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="startDate">Since:</label>
                            <input type="date" class="form-control" id="startDate" value="@today">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="endDate">To:</label>
                            <input type="date" class="form-control" id="endDate" value="@today">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="projectId">Project</label>
                            <select class="form-control" id="projectId">
                                <option value="">All Projects</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="categoryId">Category</label>
                            <select class="form-control" id="categoryId">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="accountId">Accounts</label>
                            <select class="form-control" id="accountId">
                                <option value="">All Accounts</option>
                                <!-- Account list will be populated via JavaScript -->
                            </select>
                        </div>
                    </div>
                </div>
                <!-- Column Visibility Controls -->
                <div class="mt-4">
                    <h6>Show/Hide Columns</h6>
                    <div class="column-toggles">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showDate" checked>
                            <label class="form-check-label" for="showDate">Date</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showDebit" checked>
                            <label class="form-check-label" for="showDebit">Debit</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showCredit" checked>
                            <label class="form-check-label" for="showCredit">Credit</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showBalance" checked>
                            <label class="form-check-label" for="showBalance">Balance</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showDescription" checked>
                            <label class="form-check-label" for="showDescription">Description</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="showAccount" checked>
                            <label class="form-check-label" for="showAccount">Account</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Generate Report</button>
            </form>
        </div>
    </div>

    <div id="reportResults" style="display:none;">
        <div class="search-box mb-3">
            <input type="text" id="reportSearch" class="form-control" placeholder="Search...">
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped" id="masterReportTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th class="date-column">Date</th>
                        <th class="description-column">Description</th>
                        <th class="account-column">Account</th>
                        <th class="debit-column text-right">Debit</th>
                        <th class="credit-column text-right">Credit</th>
                        <th class="balance-column text-right">Balance</th>
                    </tr>
                </thead>
                <tbody id="reportData">
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-right"><strong>Totals:</strong></td>
                        <td class="text-right" id="totalDebit"></td>
                        <td class="text-right" id="totalCredit"></td>
                        <td class="text-right" id="netBalance"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Group By Views -->
        <div class="mt-5">
            <h4>Group By Account</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Account</th>
                            <th class="text-right">Debit</th>
                            <th class="text-right">Credit</th>
                            <th class="text-right">Balance</th>
                        </tr>
                    </thead>
                    <tbody id="accountGroupData">
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-5">
            <h4>Group By Category</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th class="text-right">Debit</th>
                            <th class="text-right">Credit</th>
                            <th class="text-right">Balance</th>
                        </tr>
                    </thead>
                    <tbody id="categoryGroupData">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/masterReport.js"></script>
}