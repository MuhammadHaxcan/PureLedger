@model PureLedger.ViewModels.MasterReportPageViewModel
@{
    ViewData["Title"] = "Master Report";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-file-alt me-2"></i>Master Report</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Report Parameters
            </h6>
        </div>
        <div class="card-body">
            <form id="masterReportForm">
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Since</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="startDate" value="@today" required>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">To</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="endDate" value="@today" required>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Project <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                            <select class="form-select" id="projectId" required>
                                <option value="">Select Project</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Category</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-list"></i></span>
                            <select class="form-select" id="categoryId">
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Account</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <select class="form-select" id="accountId">
                                <option value="">All Accounts</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label d-block">Column Visibility</label>
                        <div class="btn-group column-toggles" role="group">
                            <input type="checkbox" class="btn-check" id="showDate" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showDate">
                                <i class="fas fa-calendar-day"></i> Date
                            </label>

                            <input type="checkbox" class="btn-check" id="showDescription" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showDescription">
                                <i class="fas fa-align-left"></i> Description
                            </label>

                            <input type="checkbox" class="btn-check" id="showAccount" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showAccount">
                                <i class="fas fa-user"></i> Account
                            </label>

                            <input type="checkbox" class="btn-check" id="showDebit" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showDebit">
                                <i class="fas fa-plus"></i> Debit
                            </label>

                            <input type="checkbox" class="btn-check" id="showCredit" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showCredit">
                                <i class="fas fa-minus"></i> Credit
                            </label>

                            <input type="checkbox" class="btn-check" id="showBalance" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showBalance">
                                <i class="fas fa-balance-scale"></i> Balance
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Add this after the Column Visibility section and before the Generate Report button -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Search</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control" id="globalReportSearch" placeholder="Search all report data...">
                            <button type="button" class="btn btn-outline-secondary" id="clearSearch">
                                <i class="fas fa-times"></i> Clear
                            </button>
                        </div>
                        <small class="form-text text-muted">Search across all report data including accounts, descriptions, and values</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-chart-bar me-1"></i> Generate Report
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="reportResults" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-table me-2"></i>Master Report Results
                </h6>
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="reportSearch" class="form-control" placeholder="Search records...">
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered" id="masterReportTable" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th class="date-column">Date</th>
                                <th class="description-column">Description</th>
                                <th class="account-column">Account</th>
                                <th class="debit-column text-end">Debit</th>
                                <th class="credit-column text-end">Credit</th>
                                <th class="balance-column text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody id="reportData">
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">TOTAL</td>
                                <td class="text-end fw-bold" id="totalDebit">0.00</td>
                                <td class="text-end fw-bold" id="totalCredit">0.00</td>
                                <td class="text-end fw-bold" id="netBalance">0.00</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Account Summary -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-users me-2"></i>Account Summary
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="accountSummaryTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Account</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody id="accountGroupData">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Category Summary -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-tags me-2"></i>Category Summary
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="categorySummaryTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Category</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody id="categoryGroupData">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Define API routes for master report
        var routes = {
            getCategoriesByProject: '@Url.Action("GetCategoriesByProject", "Reporting")',
            getAccountsByCategory: '@Url.Action("GetAccountsByCategory", "Reporting")',
            getMasterReportData: '@Url.Action("GetMasterReportData", "Reporting")'
        };
    </script>
    <script src="~/js/master-report.js" asp-append-version="true"></script>
}

<style>
    /* Remove dropdown arrows from all select elements */
    select.form-select {
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        appearance: none !important;
        background-image: none !important;
        padding-right: 0.75rem !important;
    }

        /* For Firefox */
        select.form-select::-ms-expand {
            display: none;
        }

    /* Table number columns alignment */
    .text-end {
        text-align: right !important;
    }

    /* Card header padding */
    .card-header.py-3 {
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
    }

    /* Column toggle buttons */
    .column-toggles .btn {
        border-radius: 0;
    }

        .column-toggles .btn:first-child {
            border-top-left-radius: 0.25rem;
            border-bottom-left-radius: 0.25rem;
        }

        .column-toggles .btn:last-child {
            border-top-right-radius: 0.25rem;
            border-bottom-right-radius: 0.25rem;
        }

    /* Table styles */
    #masterReportTable td,
    #accountSummaryTable td,
    #categorySummaryTable td {
        vertical-align: middle;
    }

    /* Monospace for numbers */
    .text-end {
        font-family: monospace;
        font-size: 0.9rem;
    }

    /* Negative values in red */
    .negative-balance {
        color: #dc3545;
    }

    /* Add this to your existing styles */
    .id-container {
        display: flex;
        flex-direction: column;
    }

    .voucher-link {
        color: #375a7f;
        text-decoration: none;
        font-weight: 500;
        display: block;
        margin-bottom: 2px;
    }

        .voucher-link:hover {
            color: #2a4766;
            text-decoration: underline;
        }

    .entry-id {
        font-size: 0.85em;
        color: #6c757d;
        display: block;
    }

    /* Update table styles to handle multi-line content better */
    #masterReportTable td {
        vertical-align: middle;
        padding: 0.5rem;
    }

    /* Automatic loading indicator */
    #loadingStatus {
        font-size: 0.9rem;
    }
</style>