@using PureLedger.ViewModels.Reporting
@model MasterReportPageViewModel
@{
    ViewData["Title"] = "Master Report";
    var today = DateTime.Now.ToString("yyyy-MM-dd");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-file-alt me-2"></i>Master Report</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Report Parameters
            </h6>
        </div>
        <div class="card-body">
            <form id="masterReportForm">
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Since</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="startDate" value="@today">
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">To</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="endDate" value="@today">
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Project <span class="text-danger">*</span></label>
                        <div class="select-container">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                                <input type="text" class="form-control select-search project-search"
                                       placeholder="Search project..." autocomplete="off">
                            </div>
                            <select class="form-select d-none" id="projectId" required>
                                <option value="">Select Project</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                            <div class="select-dropdown project-dropdown"></div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Category</label>
                        <div class="select-container">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-list"></i></span>
                                <input type="text" class="form-control select-search category-search"
                                       placeholder="Search category..." autocomplete="off" disabled>
                            </div>
                            <select class="form-select d-none" id="categoryId" disabled>
                                <option value="">All Categories</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <div class="select-dropdown category-dropdown"></div>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Account</label>
                        <div class="select-container">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" class="form-control select-search account-search"
                                       placeholder="Search account..." autocomplete="off" disabled>
                            </div>
                            <select class="form-select d-none" id="accountId" disabled>
                                <option value="">All Accounts</option>
                            </select>
                            <div class="select-dropdown account-dropdown"></div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Booker</label>
                        <div class="select-container">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                                <input type="text" class="form-control select-search booker-search"
                                       placeholder="Search booker..." autocomplete="off">
                            </div>
                            <select class="form-select d-none" id="bookerId">
                                <option value="">All Bookers</option>
                            </select>
                            <div class="select-dropdown booker-dropdown"></div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-chart-bar me-1"></i> Generate Report
                            </button>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label d-block">Column Visibility</label>
                        <div class="btn-group column-toggles" role="group">
                            <input type="checkbox" class="btn-check" id="showDate" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showDate">
                                <i class="fas fa-calendar-day"></i> Entry Date
                            </label>

                            <input type="checkbox" class="btn-check" id="showCreditableDate" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showCreditableDate">
                                <i class="fas fa-calendar-check"></i> Creditable Date
                            </label>

                            <input type="checkbox" class="btn-check" id="showDescription" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showDescription">
                                <i class="fas fa-align-left"></i> Description
                            </label>

                            <input type="checkbox" class="btn-check" id="showAccount" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showAccount">
                                <i class="fas fa-user"></i> Account
                            </label>

                            <input type="checkbox" class="btn-check" id="showBooker" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showBooker">
                                <i class="fas fa-user-tag"></i> Booker
                            </label>

                            <input type="checkbox" class="btn-check" id="showQuantity" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showQuantity">
                                <i class="fas fa-cubes"></i> Quantity
                            </label>

                            <input type="checkbox" class="btn-check" id="showDebit" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showDebit">
                                <i class="fas fa-plus"></i> Debit
                            </label>

                            <input type="checkbox" class="btn-check" id="showCredit" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showCredit">
                                <i class="fas fa-minus"></i> Credit
                            </label>

                            <input type="checkbox" class="btn-check" id="showBalance" checked autocomplete="off">
                            <label class="btn btn-outline-primary btn-sm" for="showBalance">
                                <i class="fas fa-balance-scale"></i> Balance
                            </label>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="reportResults" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-table me-2"></i>Master Report Results
                </h6>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Search</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input id="searchBox" class="form-control" placeholder="Filter results..." />
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered" id="masterReportTable" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th class="date-column">Entry Date</th>
                                <th class="creditable-date-column">Creditable Date</th>
                                <th class="description-column">Description</th>
                                <th class="account-column">Account</th>
                                <th class="booker-column">Booker</th>
                                <th class="quantity-column text-end">Quantity</th>
                                <th class="debit-column text-end">Debit</th>
                                <th class="credit-column text-end">Credit</th>
                                <th class="balance-column text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody id="reportData"></tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="6" class="text-end fw-bold">TOTAL</td>
                                <td class="quantity-column text-end fw-bold" id="totalQuantity">0</td>
                                <td class="debit-column text-end fw-bold" id="totalDebit">0.00</td>
                                <td class="credit-column text-end fw-bold" id="totalCredit">0.00</td>
                                <td class="balance-column text-end fw-bold" id="netBalance">0.00</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Account Summary -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-users me-2"></i>Account Summary
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="accountSummaryTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Account</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody id="accountGroupData">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Category Summary -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-tags me-2"></i>Category Summary
                </h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="categorySummaryTable">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Category</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody id="categoryGroupData">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Define API routes for master report
        var routes = {
            getCategoriesByProject: '@Url.Action("GetCategoriesByProject", "Reporting")',
            getAccountsByCategory: '@Url.Action("GetAccountsByCategory", "Reporting")',
            getMasterReportData: '@Url.Action("GetMasterReportData", "Reporting")'
        };
    </script>
    <script src="~/js/master-report.js" asp-append-version="true"></script>
}