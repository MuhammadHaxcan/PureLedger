@model PureLedger.ViewModels.JournalVoucherReportViewModel
@{
    Layout = null;
    bool isDC = Model.VoucherType == "DC";
    bool isInv = Model.VoucherType == "INV";
    bool isJV = !isDC && !isInv;
    string challanType = Model.IsPartial ? "Partial Delivery Challan" : "Full Delivery Challan";
    string documentTitle = isInv ? "Invoice" : isDC ? "Delivery Challan" : "Journal Voucher";
    string documentDateFormat = isInv ? "dd-MMM-yyyy" : "dd-MM-yyyy";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle #@Model.JvId</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/css/PrintVoucher.css" rel="stylesheet" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Pass filter value from server to client
        var currentFilter = '@(ViewBag.Filter ?? "all")';
    </script>
</head>
<body data-voucher-type="@Model.VoucherType" data-voucher-id="@Model.JvId">
    <div class="container-fluid print-container">
        <!-- Print Controls -->
        <div class="d-print-none text-end mb-3 print-controls">
            <button class="btn btn-secondary me-2" onclick="window.close()">
                <i class="fas fa-times me-1"></i> Close
            </button>
            <button class="btn btn-success" onclick="window.print()">
                <i class="fas fa-print me-1"></i> Print
            </button>
        </div>

        <div class="card shadow mb-4">
            <div class="card-body p-4">
                <!-- Document Header -->
                <div class="header-section mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-0">@documentTitle #@Model.JvId</h2>
                        <div class="text-muted">
                            @if (isInv)
                            {
                                <span>@Model.CreatedDate.ToString(documentDateFormat)</span>
                            }
                            else if (isDC)
                            {
                                <span>@challanType - @Model.CreatedDate.ToShortDateString()</span>
                            }
                            else
                            {
                                <span>Journal Voucher - @Model.CreatedDate.ToShortDateString()</span>
                            }
                        </div>
                    </div>
                    <div class="logo-container">
                        <img src="/images/logo.png" class="logo" alt="Company Logo" />
                    </div>
                </div>

                <!-- Document Content -->
                @if (isInv)
                {
                    <partial name="_InvoiceDetails" model="Model" />
                }
                else if (isDC)
                {
                    <partial name="_DeliveryChallanDetails" model="Model" />
                }
                else
                {
                    <partial name="_JournalVoucherDetails" model="Model" />
                }

                <!-- Signature Section -->
                <div class="signatures-section mt-5">
                    <div class="row">
                        <div class="col-md-4 signature-block">
                            <div class="signature-line"></div>
                            <div class="signature-title">Accountant</div>
                        </div>
                        <div class="col-md-4 signature-block">
                            <div class="signature-line">@Model.AuthorizedBy</div>
                            <div class="signature-title">Authorized By</div>
                        </div>
                        <div class="col-md-4 signature-block">
                            <div class="signature-line">@Model.ReceivedBy</div>
                            <div class="signature-title">Received/Paid By</div>
                        </div>
                    </div>
                </div>

                <!-- Document Footer -->
                <div class="document-footer mt-4 text-center">
                    <small class="text-muted">
                        Document ID: @Model.JvId | Generated on: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")
                    </small>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/PrintVoucher.js" asp-append-version="true"></script>
</body>
</html>