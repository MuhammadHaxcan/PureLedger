@using PureLedger.Models
@using PureLedger.ViewModels.Reporting
@model JournalVoucherReportViewModel
@{
    // Using null layout to avoid including navigation elements for print view
    Layout = null;

    bool isDC = Model.VoucherType == VoucherType.DC;
    bool isInv = Model.VoucherType == VoucherType.INV;
    bool isJV = Model.VoucherType == VoucherType.JV;
    string documentTitle = isInv ? "Invoice" : isDC ? "Delivery Challan" : "Journal Voucher";
    string documentDateFormat = isInv ? "dd-MMM-yyyy" : "dd-MM-yyyy";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@documentTitle #@Model.JvId</title>
    <!-- Meta tags to help prevent URL in print -->
    <meta name="author" content="PureLedger">
    <meta name="description" content="@documentTitle #@Model.JvId">
    <meta name="format-detection" content="telephone=no">
    <meta name="robots" content="noindex">

    <!-- Preload critical resources -->
    <link rel="preload" href="/images/logo.png" as="image">

    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'" />
    <link href="~/css/PrintVoucher.css" rel="stylesheet" asp-append-version="true" />

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" defer></script>

    <!-- Configuration -->
    <script>
        // Define VoucherType enum to match C# enum
        window.VoucherType = {
            JV: '@VoucherType.JV',
            DC: '@VoucherType.DC',
            INV: '@VoucherType.INV'
        };

        // Pass filter value from server to client
        var currentFilter = '@(ViewBag.Filter ?? "all")';

        // Define routes for any API calls
        var routes = {
            printVoucher: '@Url.Action("PrintVoucher", "Reporting")',
            customerBalances: '@Url.Action("GetCustomerBalances", "Reporting")'
        };
    </script>
</head>
<body data-voucher-type="@Model.VoucherType.ToString()" data-voucher-id="@Model.JvId">
    <div class="container-fluid print-container">
        <!-- Print Controls -->
        <div class="d-print-none text-end mb-3 print-controls">
            <button class="btn btn-secondary me-2" id="btnClose">
                <i class="fas fa-times me-1"></i> Close
            </button>
            <button class="btn btn-success" id="btnPrint">
                <i class="fas fa-print me-1"></i> Print
            </button>
        </div>

        <div class="card shadow mb-4">
            <div class="card-body p-4">
                <!-- Document Header -->
                <div class="header-section mb-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="mb-0">@documentTitle #@Model.JvId</h2>
                        <div class="text-muted">
                            @if (isInv)
                            {
                                <span>@Model.CreatedDate.ToString(documentDateFormat)</span>
                            }
                            else if (isDC)
                            {
                                <span>Delivery Challan - @Model.CreatedDate.ToShortDateString()</span>
                            }
                            else
                            {
                                <span>Journal Voucher - @Model.CreatedDate.ToShortDateString()</span>
                            }
                        </div>
                    </div>
                    <div class="logo-container">
                        @if (!string.IsNullOrEmpty(Model.ProjectImage))
                        {
                            <!-- Use project specific image if available - ProjectImage is now a base64 data URL -->
                            <img src="@Model.ProjectImage" class="logo" alt="Project Logo" />
                        }
                        else
                        {
                            <!-- Fallback to default logo -->
                            <img src="/images/logo.png" class="logo" alt="Company Logo" />
                        }
                    </div>
                </div>

                <!-- Document Content -->
                @if (isInv)
                {
                    <partial name="_InvoiceDetails" model="Model" />
                }
                else if (isDC)
                {
                    <partial name="_DeliveryChallanDetails" model="Model" />
                }
                else
                {
                    <partial name="_JournalVoucherDetails" model="Model" />
                }

                <!-- Improved Signature Section -->
                <table width="100%" style="margin-top: 50px;">
                    <tr>
                        <td width="33%" style="text-align: center; padding: 10px;">
                            <div style="border-bottom: 1px solid #333; height: 30px; margin-bottom: 5px;">
                                &nbsp;
                            </div>
                            <div style="font-weight: bold; font-size: 15px;">
                                Accountant
                            </div>
                        </td>
                        <td width="33%" style="text-align: center; padding: 10px;">
                            <div style="border-bottom: 1px solid #333; height: 30px; margin-bottom: 5px;">
                                @Model.AuthorizedBy
                            </div>
                            <div style="font-weight: bold; font-size: 15px;">
                                Authorized By
                            </div>
                        </td>
                        <td width="33%" style="text-align: center; padding: 10px;">
                            <div style="border-bottom: 1px solid #333; height: 30px; margin-bottom: 5px;">
                                @Model.ReceivedBy
                            </div>
                            <div style="font-weight: bold; font-size: 15px;">
                                Received/Paid By
                            </div>
                        </td>
                    </tr>
                </table>

                @* <!-- Document Footer -->
                <div class="document-footer mt-4 text-center">
                    <small class="text-muted">
                        Document ID: @Model.JvId | Generated on: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm:ss")
                    </small>
                </div> *@
            </div>
        </div>
    </div>

    <script src="~/js/PrintVoucher.js" asp-append-version="true"></script>
</body>
</html>