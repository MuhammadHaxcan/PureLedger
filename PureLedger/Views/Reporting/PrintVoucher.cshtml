
@model PureLedger.ViewModels.JournalVoucherReportViewModel
@{
    Layout = null;
    bool isDC = Model.VoucherType == "DC";
    bool isInv = Model.VoucherType == "INV";
    string challanType = Model.IsPartial ? "Partial Delivery Challan" : "Full Delivery Challan";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>
        @(
            isInv ? "Invoice" :
            isDC ? "Delivery Challan" :
            "Journal Voucher"
            ) 
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/PrintVoucher.css" rel="stylesheet" />
    <script src="~/js/PrintVoucher.js"></script>
</head>
<body data-voucher-type="@Model.VoucherType" data-voucher-id="@Model.JvId">

    <div class="header-section mb-3 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-0">
                @(
                    isInv ? "Invoice" :
                    isDC ? "Delivery Challan" :
                    "Journal Voucher"
                    ) #@Model.JvId
            </h2>
            <small>
                @if (isInv)
                {
                <small>@Model.CreatedDate.ToString("dd-MMM-yyyy")</small>
                }
                else if (isDC)
                {
                <small>@challanType  - @Model.CreatedDate.ToShortDateString()</small>
                }
                else
                {
                <small>Journal Voucher  - @Model.CreatedDate.ToShortDateString()</small>
                } 
            </small>
        </div>
        <img src="/images/logo.png" class="logo" alt="Company Logo" />
    </div>

    @if (isInv)
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Customer:</strong> @Model.AccountName
                <br/>
                <strong>Address:</strong> @Model.CustomerAddress
                <br />
                <strong>City:</strong> @Model.CustomerCity
                <br />
                <strong>Phone:</strong> @Model.CustomerPhone
            </div>
            <div class="col-md-6 ">
                <strong>Due Date:</strong> @Model.CreatedDate
                <br />
                <strong>Adda:</strong> @Model.Adda
                <br />
                <strong>Builty:</strong> @Model.Builty
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>SR#</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>PKG</th>
                        <th>Rate</th>
                        <th>DISC %</th>
                        <th>NET</th>
                        <th>AMOUNT</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sr = 1;
                        foreach (var entry in Model.Entries.Where(e => e.Quantity > 0))
                        {
                            <tr>
                                <td>@(sr++)</td>
                                <td>@entry.AccountName</td>
                                <td>@entry.Quantity</td>
                                <td>@entry.PKG</td>
                                <td>@entry.Rate</td>
                                <td>@entry.Discount</td>
                                <td>@entry.NetRate</td>
                                <td>@entry.Credit</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="table-info">
                        <th colspan="2" class="text-end">Total</th>
                        <th>@Model.TotalQuantity</th>
                        <th></th>
                        <th></th>
                        <th colspan="2" class="text-end">Current Balance</th>
                        <th>@Model.TotalAmount</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else if (isDC)
    {
        <div class="row mb-3">
            <div class="col-md-6">
                <strong>Customer:</strong> @Model.AccountName
            </div>
            <div class="col-md-6 ">
                <strong>Due Date:</strong> @Model.CreatedDate
                <br />
                <strong>Adda:</strong> @Model.Adda
                <br />
                <strong>Builty:</strong> @Model.Builty
                <br />
                <strong>Remarks:</strong> @Model.Remarks
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>SR#</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>PKG</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sr = 1;
                        foreach (var entry in Model.Entries.Where(e => e.Quantity > 0))
                        {
                            <tr>
                                <td>@(sr++)</td>
                                <td>@entry.AccountName</td>
                                <td>@entry.Quantity</td>
                                <td>1</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="table-info">
                        <th colspan="2" class="text-end">Total</th>
                        <th>@Model.TotalQuantity</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
    else
    {
        <!-- Journal Voucher layout (existing layout) -->
        <div class="mb-3">
            <p><strong>Project:</strong> @Model.ProjectName</p>
            <p><strong>Booker:</strong> @Model.BookerName</p>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Account</th>
                        <th>Description</th>
                        <th>Qty</th>
                        <th>Rate</th>
                        <th>Line Total</th>
                        <th>Debit</th>
                        <th>Credit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td>@entry.AccountName</td>
                            <td>@entry.Description</td>
                            <td>@entry.Quantity</td>
                            <td>@entry.Rate.ToString("N2")</td>
                            <td>@entry.LineTotal.ToString("N2")</td>
                            <td>@entry.Debit.ToString("N2")</td>
                            <td>@entry.Credit.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-info">
                        <th colspan="2" class="text-end">Totals</th>
                        <th>@Model.TotalQuantity</th>
                        <th></th>
                        <th>@Model.TotalActualAmount.ToString("N2")</th>
                        <th>@Model.TotalAmount.ToString("N2")</th>
                        <th>@Model.TotalAmount.ToString("N2")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="footer-label">Accountant:</div>
            <p></p>
        </div>
        <div class="col-md-4">
            <div class="footer-label">Authorized By:</div>
            <p>@Model.AuthorizedBy</p>
        </div>
        <div class="col-md-4">
            <div class="footer-label">Received/Paid By:</div>
            <p>@Model.ReceivedBy</p>
        </div>
    </div>

    <div class="d-print-none text-end mb-3">
        <button class="btn btn-success no-print" onclick="window.print()">🖨️ Print</button>

    </div>

</body>
</html>
