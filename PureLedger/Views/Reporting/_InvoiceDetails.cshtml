@model PureLedger.ViewModels.JournalVoucherReportViewModel

<!-- Customer & Invoice Information -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="customer-info">
            <h5 class="info-heading">Customer Information</h5>
            <table class="info-table">
                <tr>
                    <td><strong>Customer:</strong></td>
                    <td>@Model.CustomerAccountName</td>
                </tr>
                <tr>
                    <td><strong>Address:</strong></td>
                    <td>@Model.CustomerAddress</td>
                </tr>
                <tr>
                    <td><strong>City:</strong></td>
                    <td>@Model.CustomerCity</td>
                </tr>
                <tr>
                    <td><strong>Phone:</strong></td>
                    <td>@Model.CustomerPhone</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="invoice-info">
            <h5 class="info-heading">Invoice Details</h5>
            <table class="info-table">
                <tr>
                    <td><strong>Due Date:</strong></td>
                    <td>@Model.CreatedDate</td>
                </tr>
                <tr>
                    <td><strong>Adda:</strong></td>
                    <td>@Model.Adda</td>
                </tr>
                <tr>
                    <td><strong>Builty:</strong></td>
                    <td>@(Model.Builty)@(Model.CartageAmount > 0 ? $" ({Model.CartageAmount:N2})" : "")</td>
                </tr>
            </table>
        </div>
    </div>
</div>

<!-- Invoice Items Table -->
<div class="table-responsive mb-4">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>SR#</th>
                <th>Product Name</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">PKG</th>
                <th class="text-end">Rate</th>
                <th class="text-end">DISC %</th>
                <th class="text-end">NET Rate</th>
                <th class="text-end">AMOUNT</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sr = 1;
                foreach (var entry in Model.Entries.Where(e => e.Quantity > 0))
                {
                    <tr>
                        <td>@(sr++)</td>
                        <td>@entry.AccountName</td>
                        <td class="text-end">@entry.Quantity</td>
                        <td class="text-end">@entry.PKG</td>
                        <td class="text-end">@entry.Rate.ToString("N2")</td>
                        <td class="text-end">@entry.Discount.ToString("N2")%</td>
                        <td class="text-end">@entry.NetRate.ToString("N2")</td>
                        <td class="text-end">@entry.LineTotal.ToString("N2")</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr class="table-active">
                <th colspan="2" class="text-end">Total</th>
                <th class="text-end">@Model.TotalQuantity</th>
                <th class="text-end"></th>
                <th class="text-end"></th>
                <th class="text-end"></th>
                <th class="text-end">Net Amount</th>
                <th class="text-end">@Model.TotalAmount.ToString("N2")</th>
            </tr>
            @if (Model.ForChargesAmount > 0)
            {
                <tr class="table-warning">
                    <td colspan="7" class="text-end"><strong>Less: FOR Charges</strong></td>
                    <td class="text-end">@Model.ForChargesAmount.ToString("N2")</td>
                </tr>
            }
            @* Removed the Cartage row as it's now displayed in the Builty field *@
            @if (Model.ForChargesAmount > 0)
            {
                <tr class="table-info">
                    <td colspan="7" class="text-end"><strong>Final Amount</strong></td>
                    <td class="text-end"><strong>@(Model.TotalAmount - Model.ForChargesAmount).ToString("N2")</strong></td>
                </tr>
            }
        </tfoot>
    </table>
</div>

<!-- Customer Running Balance Display -->
<div class="row mb-2">
    <div class="col-md-6 offset-md-6">
        <div class="alert alert-secondary text-end">
            <strong>Customer Running Balance:</strong>
            @{
                var balance = ViewBag.CustomerRunningBalance is decimal bal ? bal : 0m;
                <span id="customerRunningBalance">@balance.ToString("N2")</span>
            }
        </div>
    </div>
</div>