@model PureLedger.ViewModels.AgingReportPageViewModel
@{
    ViewData["Title"] = "Aging Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-hourglass-half me-2"></i>Aging Report</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Report Parameters
            </h6>
        </div>
        <div class="card-body">
            <form id="agingReportForm">
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Reference Date <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="referenceDate" required>
                        </div>
                        <small class="form-text text-muted">The date to calculate aging from</small>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Project</label>
                        <div class="select-container">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                                <input type="text" class="form-control select-search project-search"
                                       placeholder="Search project..." autocomplete="off">
                            </div>
                            <select class="form-select d-none" id="projectId">
                                <option value="">All Projects</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                            <div class="select-dropdown project-dropdown"></div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Category <span class="text-danger">*</span></label>
                        <div class="select-container">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-list"></i></span>
                                <input type="text" class="form-control select-search category-search"
                                       placeholder="Search category..." autocomplete="off" disabled>
                            </div>
                            <select class="form-select d-none" id="categoryId" required disabled>
                                <option value="">Select Category</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <div class="select-dropdown category-dropdown"></div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">&nbsp;</label>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-chart-bar me-1"></i> Generate Report
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Hidden results container similar to other reports -->
    <div id="reportResults" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-table me-2"></i>Aging Report Results
                </h6>
                <div id="reportSummary"></div>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Search</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input id="searchBox" class="form-control" placeholder="Filter results..." />
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered" id="agingReportTable" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>Account</th>
                                <th class="text-end">Total Debit</th>
                                <th class="text-end">Total Credit</th>
                                <th class="text-end">Net Balance</th>
                            </tr>
                        </thead>
                        <tbody id="reportData">
                            <!-- Data will be populated by JavaScript -->
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr class="fw-bold">
                                <td>TOTAL</td>
                                <td class="text-end" id="totalDebit">0.00</td>
                                <td class="text-end" id="totalCredit">0.00</td>
                                <td class="text-end" id="totalNet">0.00</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Define API routes for aging report
        var routes = {
            getCategoriesByProject: '@Url.Action("GetCategoriesByProject", "Reporting")',
            getAgingReportData: '@Url.Action("GetAgingReportData", "Reporting")'
        };
    </script>
    <script src="~/js/agingReport.js" asp-append-version="true"></script>
}