@model PureLedger.ViewModels.ProductReportPageViewModel
@{
    ViewData["Title"] = "Product Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-box me-2"></i>Product Stock & Margin Report</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Report Parameters
            </h6>
        </div>
        <div class="card-body">
            <form id="productReportForm">
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Since <small class="text-muted">(Optional - Leave empty for all data)</small></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="startDate">
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">To <small class="text-muted">(Optional - Leave empty for all data)</small></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control" id="endDate">
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Project <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                            <select class="form-select" id="projectId" required>
                                <option value="">Select Project</option>
                                @foreach (var project in Model.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Category</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-sitemap"></i></span>
                            <select class="form-select" id="categoryId" disabled>
                                <option value="">All Categories</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Account (Product)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-box"></i></span>
                            <select class="form-select" id="accountId" disabled>
                                <option value="">All Products</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Location</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                            <select class="form-select" id="locationId">
                                <option value="">All Locations</option>
                                @foreach (var location in Model.Locations)
                                {
                                    <option value="@location.Id">@location.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3 d-flex align-items-end">
                        <button type="button" id="clearDatesBtn" class="btn btn-outline-secondary">
                            <i class="fas fa-calendar-times"></i> Clear Dates
                        </button>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Search</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" class="form-control" id="globalReportSearch" placeholder="Search products...">
                            <button type="button" class="btn btn-outline-secondary" id="clearSearch">
                                <i class="fas fa-times"></i> Clear
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-chart-bar me-1"></i> Generate Report
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div id="reportResults" style="display:none;">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-table me-2"></i>Product Summary Report
                </h6>
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="reportSearch" class="form-control" placeholder="Search products...">
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="productReportTable" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Last Voucher</th>
                                <th class="text-end">Entry Date</th>
                                <th class="text-end">Due Date</th>
                                <th class="text-end">Debit Qty</th>
                                <th class="text-end">Credit Qty</th>
                                <th class="text-end">Balance Qty</th>
                                <th class="text-end">Avg Rate</th>
                                <th class="text-end">Total Debit</th>
                                <th class="text-end">Total Credit</th>
                                <th class="text-end">COGS</th>
                                <th class="text-end">Margin</th>
                                <th class="text-end">Margin %</th>
                            </tr>
                        </thead>
                        <tbody id="reportData">
                            <!-- Product report data will be rendered here -->
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">TOTALS</td>
                                <td class="text-end fw-bold" id="totalDebitQty">0</td>
                                <td class="text-end fw-bold" id="totalCreditQty">0</td>
                                <td class="text-end fw-bold" id="netQty">0</td>
                                <td class="text-end fw-bold">-</td>
                                <td class="text-end fw-bold" id="totalDebit">0.00</td>
                                <td class="text-end fw-bold" id="totalCredit">0.00</td>
                                <td class="text-end fw-bold" id="totalCOGS">0.00</td>
                                <td class="text-end fw-bold" id="totalMargin">0.00</td>
                                <td class="text-end fw-bold" id="avgMarginPercent">0.00%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Define API routes for product report
        var routes = {
            getCategoriesByProject: '@Url.Action("GetCategoriesByProject", "Reporting")',
            getAccountsByCategory: '@Url.Action("GetAccountsByCategory", "Reporting")',
            getProductReportData: '@Url.Action("GetProductReportData", "Reporting")'
        };
    </script>
    <script src="~/js/product-report.js" asp-append-version="true"></script>
}

<style>
    /* Voucher styling */
    .voucher-link {
        font-weight: 500;
        color: #0d6efd;
        text-decoration: none;
    }

        .voucher-link:hover {
            text-decoration: underline;
        }

    /* Text alignment for number columns */
    .text-end {
        text-align: right !important;
        font-family: monospace;
        font-size: 0.9rem;
    }

    /* Negative values in red */
    .negative-balance {
        color: #dc3545;
    }

    /* Positive margin in green */
    .positive-margin {
        color: #198754;
    }

    /* Previous balance row styling */
    .previous-balance-row {
        background-color: #f2f2f2;
        font-style: italic;
    }
</style>