@model PureLedger.ViewModels.AgingReportPageViewModel
@{
    ViewData["Title"] = "Account Report";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-chart-pie me-2"></i>Account Report</h2>
    </div>

    <div id="alertArea">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-filter me-2"></i>Filter Options
            </h6>
        </div>
        <div class="card-body">
            <div class="row align-items-end mb-3">
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label">Project</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-project-diagram"></i></span>
                        <select id="projectId" class="form-select">
                            <option value="">Select Project</option>
                            @foreach (var p in Model.Projects)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label">Category</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-list"></i></span>
                        <select id="categoryId" class="form-select">
                            <option value="">Select Category</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <label class="form-label">Account</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-file-invoice-dollar"></i></span>
                        <select id="accountId" class="form-select" disabled>
                            <option value="">All Accounts</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <button id="goBtn" class="btn btn-primary me-2">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                    <button id="allProjectBtn" class="btn btn-secondary">
                        <i class="fas fa-globe me-1"></i> All Projects
                    </button>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input id="searchBox" class="form-control" placeholder="Filter results..." />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list-alt me-2"></i>Account Report Results
            </h6>
            <div id="reportSummary"></div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="accountReportTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th>Account Name</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                            <th class="text-end">Balance</th>
                        </tr>
                    </thead>
                    <tbody id="reportData">
                        <tr>
                            <td colspan="6" class="text-center">Please select at least one filter</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/accountReport.js" asp-append-version="true"></script>
}

<style>
    /* Remove dropdown arrows from all select elements */
    select.form-select {
        -webkit-appearance: none !important;
        -moz-appearance: none !important;
        appearance: none !important;
        background-image: none !important;
        padding-right: 0.75rem !important;
    }

        /* For Firefox */
        select.form-select::-ms-expand {
            display: none;
        }

    /* Table number columns alignment */
    #accountReportTable td.text-end {
        text-align: right;
        font-family: monospace;
        font-size: 1rem;
    }

    /* Highlight negative balances */
    #accountReportTable .negative-balance {
        color: #dc3545;
    }
</style>